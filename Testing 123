    Set ws = wb.Sheets.Add(After:=wb.Sheets(wb.Sheets.Count))
    ws.Name = "PARSER"
    ws.Tab.Color = RGB(39, 174, 96)
    ws.ShowGridLines = False
    ws.Columns("A").ColumnWidth = 2
    ws.Columns("B").ColumnWidth = 18
    ws.Columns("C").ColumnWidth = 28
    ws.Columns("D").ColumnWidth = 32
    ws.Columns("E").ColumnWidth = 58
    ws.Columns("F").ColumnWidth = 2

    ws.Rows(1).RowHeight = 6
    ws.Rows(2).RowHeight = 38
    ws.Range("B2:E2").Merge
    With ws.Range("B2")
        .Value = "  SWIFT Message Decoder  —  Paste your message below and click DECODE"
        .Font.Name = "Arial": .Font.Size = 15: .Font.Bold = True
        .Font.Color = RGB(255, 255, 255): .Interior.Color = RGB(13, 27, 42)
        .HorizontalAlignment = xlLeft: .VerticalAlignment = xlCenter
    End With

    ws.Rows(3).RowHeight = 30
    ws.Rows(4).RowHeight = 18
    ws.Range("B4:E4").Merge
    With ws.Range("B4")
        .Value = "  PASTE YOUR COMPLETE SWIFT MESSAGE IN THE YELLOW BOX BELOW:"
        .Font.Name = "Arial": .Font.Size = 9: .Font.Bold = True
        .Font.Color = RGB(255, 255, 255): .Interior.Color = RGB(52, 73, 94)
    End With

    ws.Rows(5).RowHeight = 110
    ws.Range("B5:E5").Merge
    With ws.Range("B5")
        .Value = "  Paste your complete SWIFT message here." & Chr(10) & _
                 "  It can start with {1:   or directly with a field tag like :20:" & Chr(10) & _
                 "  Include the entire message — do not remove any lines." & Chr(10) & _
                 "  Then click the green DECODE THIS MESSAGE button above."
        .Font.Name = "Arial": .Font.Size = 10: .Font.Color = RGB(160, 160, 160)
        .Interior.Color = RGB(255, 253, 210)
        .HorizontalAlignment = xlLeft: .VerticalAlignment = xlTop
        .WrapText = True: .IndentLevel = 1
        .Borders.LineStyle = xlContinuous
        .Borders.Weight = xlMedium
        .Borders.Color = RGB(245, 166, 35)
    End With

    ws.Rows(6).RowHeight = 6
    ws.Rows(7).RowHeight = 22

    Dim hc As Variant: hc = Array("B", "C", "D", "E")
    Dim ht As Variant: ht = Array("SECTION", "FIELD CODE", "WHAT THIS FIELD IS", "WHAT IT MEANS  (PLAIN ENGLISH — no jargon)")
