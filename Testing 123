        "RC[-1]=""Completed"",""Completed""," & _
        "RC[-1]=""SLA Breached"",""Critical""," & _
        "RC[-1]=""Due Today"",""High""," & _
        "RC[-1]=""Due Tomorrow"",""Medium""," & _
        "TRUE,""Normal""))"

    ws.Range("Y3:Y10002").FormulaR1C1 = _
        "=IF(OR(RC[-23]="""",RC[1]=""""),"""",NETWORKDAYS(RC[-23],RC[1])-1)"

    ws.Range("B3:B10002").NumberFormat = "DD-MMM-YY"
    ws.Range("K3:K10002").NumberFormat = "DD-MMM-YY"
    ws.Range("X3:X10002").NumberFormat = "DD-MMM-YY"

    With ws.Range("A3:Z10002")
        .Font.Name = "Arial"
        .Font.Size = 9
        .Font.Color = HexToLong(hCharcoal)
        .VerticalAlignment = xlCenter
        .Borders.LineStyle = xlContinuous
        .Borders.Color = HexToLong("C0C8D0")
        .Borders.Weight = xlThin
    End With

    With ws.Range("G3:G10002").Validation
        .Delete
        .Add Type:=xlValidateList, Formula1:="='Master Data'!$A$3:$A$12"
        .ShowError = True
        .ErrorMessage = "Please select from the list."
        .ErrorTitle = "Invalid Entry"
    End With

    With ws.Range("H3:H10002").Validation
        .Delete
        .Add Type:=xlValidateList, Formula1:="='Master Data'!$D$3:$D$4"
        .ShowError = True
        .ErrorMessage = "Please select from the list."
        .ErrorTitle = "Invalid Entry"
    End With

    With ws.Range("I3:I10002").Validation
        .Delete
        .Add Type:=xlValidateList, Formula1:="='Master Data'!$B$3:$B$12"
        .ShowError = True
        .ErrorMessage = "Please select from the list."
        .ErrorTitle = "Invalid Entry"
    End With

    With ws.Range("J3:J10002").Validation
        .Delete
        .Add Type:=xlValidateList, Formula1:="='Master Data'!$C$3:$C$10"
        .ShowError = True
        .ErrorMessage = "Please select from the list."
        .ErrorTitle = "Invalid Entry"
    End With

    With ws.Range("M3:M10002").Validation
        .Delete
