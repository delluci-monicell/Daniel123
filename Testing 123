    '=== FIND TARGET FOLDER ===
    Dim targetFolder As Object
    Dim rootFolder As Object
    Dim f As Object
    Dim subF As Object
    Dim found As Boolean
    found = False

    Dim i As Integer
    For i = 1 To olNs.Stores.Count
        On Error Resume Next
        Set rootFolder = olNs.Stores(i).GetRootFolder()
        If Err.Number <> 0 Then
            Err.Clear
            GoTo NextStore
        End If
        On Error GoTo 0

        ' Check top level folders
        For Each f In rootFolder.Folders
            If LCase(Trim(f.Name)) = LCase(Trim(outlookFolder)) Then
                Set targetFolder = f
                found = True
                Exit For
            End If
            ' Check one level deeper
            For Each subF In f.Folders
                If LCase(Trim(subF.Name)) = LCase(Trim(outlookFolder)) Then
                    Set targetFolder = subF
                    found = True
                    Exit For
                End If
            Next subF
            If found Then Exit For
        Next f

        If found Then Exit For

NextStore:
    Next i

    If Not found Then
        ' Show all top level folder names to help diagnose
        Dim folderList As String
        folderList = ""
        On Error Resume Next
        Set rootFolder = olNs.Stores(1).GetRootFolder()
        For Each f In rootFolder.Folders
            folderList = folderList & f.Name & vbNewLine
        Next f
        On Error GoTo 0
        MsgBox "Folder '" & outlookFolder & "' not found." & vbNewLine & vbNewLine & _
               "Top level folders found:" & vbNewLine & folderList, vbCritical
        Exit Sub
    End If
