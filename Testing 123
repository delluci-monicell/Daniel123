Option Explicit

Sub DownloadPDFAttachments()

    On Error GoTo MainError

    Dim ws As Worksheet
    Dim logWs As Worksheet
    Dim errWs As Worksheet

    Set ws = ThisWorkbook.Sheets("PDF Downloader")
    Set logWs = ThisWorkbook.Sheets("Download Log")
    Set errWs = ThisWorkbook.Sheets("Error Log")

    Dim senderEmail As String
    Dim folderName As String
    Dim savePath As String

    Dim dateFrom As Date
    Dim dateTo As Date
    Dim timeFrom As String
    Dim timeTo As String

    senderEmail = Trim(ws.Range("C4").Value)
    dateFrom = ws.Range("C5").Value
    timeFrom = Trim(ws.Range("C6").Text)

    dateTo = ws.Range("C7").Value
    timeTo = Trim(ws.Range("C8").Text)

    savePath = Trim(ws.Range("C9").Value)
    folderName = Trim(ws.Range("C10").Value)

    If Right(savePath, 1) <> "\" Then
        savePath = savePath & "\"
    End If

    If senderEmail = "" Then
        MsgBox "Sender email is required"
        Exit Sub
    End If

    If folderName = "" Then
        MsgBox "Outlook folder name is required"
        Exit Sub
    End If

    If Dir(savePath, vbDirectory) = "" Then
        MsgBox "Invalid save path"
        Exit Sub
    End If

    '-------------------------------
    ' Time handling
    '-------------------------------
    Dim fullFromDate As Date
    Dim fullToDate As Date

    If timeFrom = "" Then timeFrom = "00:00:00"
    If timeTo = "" Then timeTo = "23:59:59"

    fullFromDate = CDate(dateFrom & " " & timeFrom)
    fullToDate = CDate(dateTo & " " & timeTo)

    '-------------------------------
    ' Open Outlook
    '-------------------------------
    Dim olApp As Object
    Dim olNs As Object
    Dim rootFolder As Object
    Dim targetFolder As Object

    On Error Resume Next
    Set olApp = GetObject(, "Outlook.Application")

    If olApp Is Nothing Then
        Set olApp = CreateObject("Outlook.Application")
    End If
    On Error GoTo MainError

    Set olNs = olApp.GetNamespace("MAPI")

    Set rootFolder = olNs.Folders.Item(1)

    Set targetFolder = FindOutlookFolder(rootFolder, folderName)

    If targetFolder Is Nothing Then
        MsgBox "Outlook folder not found: " & folderName
        Exit Sub
    End If

    '-------------------------------
    ' Filter items
    '-------------------------------
    Dim items As Object
    Dim mi As Object
    Dim filteredItems As Collection

    Set items = targetFolder.Items
    items.Sort "[ReceivedTime]", True

    Set filteredItems = New Collection

    For Each mi In items

        If TypeName(mi) = "MailItem" Then

            If LCase(Trim(mi.SenderEmailAddress)) = LCase(senderEmail) Then

                If mi.ReceivedTime >= fullFromDate And _
                   mi.ReceivedTime <= fullToDate Then

                    filteredItems.Add mi

                End If

            End If
        End If

    Next mi

    If filteredItems.Count = 0 Then
        MsgBox "No matching emails found"
        Exit Sub
    End If

    '-------------------------------
    ' Progress Form
    '-------------------------------
    frmProgress.lblStatus.Caption = "Preparing Emails..."
    frmProgress.lblEmailCount.Caption = "0 / " & filteredItems.Count & " Emails Processed"
    frmProgress.lblDownloadedCount.Caption = "PDFs Downloaded : 0"
    frmProgress.lblBar.Width = 0

    frmProgress.Show vbModeless
    DoEvents

    '-------------------------------
    ' Log rows
    '-------------------------------
    Dim logRow As Long
    Dim errRow As Long

    logRow = logWs.Cells(logWs.Rows.Count, 1).End(xlUp).Row + 1
    errRow = errWs.Cells(errWs.Rows.Count, 1).End(xlUp).Row + 1

    '-------------------------------
    ' Process emails
    '-------------------------------
    Dim processed As Long
    Dim downloaded As Long

    Dim tempMsgPath As String
    Dim tempMail As Object
    Dim at As Object

    Dim pdfSaved As Boolean
    Dim pdfPath As String

    For Each mi In filteredItems

        processed = processed + 1

        frmProgress.lblEmailCount.Caption = _
        processed & " / " & filteredItems.Count & " Emails Processed"

        frmProgress.lblDownloadedCount.Caption = _
        "PDFs Downloaded : " & downloaded

        frmProgress.lblBar.Width = _
        (processed / filteredItems.Count) * frmProgress.fraProgress.Width

        DoEvents

        tempMsgPath = savePath & _
        "TEMP_" & Format(Now, "yyyymmdd_hhnnss") & "_" & processed & ".msg"

        On Error Resume Next
        mi.SaveAs tempMsgPath, 3
        On Error GoTo MainError

        Set tempMail = Nothing

        On Error Resume Next
        Set tempMail = olApp.Session.OpenSharedItem(tempMsgPath)
        On Error GoTo MainError

        pdfSaved = False

        If Not tempMail Is Nothing Then

            For Each at In tempMail.Attachments

                If LCase(Right(at.FileName, 4)) = ".pdf" Then

                    pdfPath = savePath & at.FileName

                    If Dir(pdfPath) <> "" Then
                        pdfPath = savePath & _
                        Format(Now, "yyyymmdd_hhnnss_") & at.FileName
                    End If

                    at.SaveAsFile pdfPath

                    downloaded = downloaded + 1
                    pdfSaved = True

                End If

            Next at

        End If

        If pdfSaved = True Then

            ' SUCCESS LOG
            logWs.Cells(logRow, 1).Value = logRow - 1
            logWs.Cells(logRow, 2).Value = Now
            logWs.Cells(logRow, 3).Value = mi.Subject
            logWs.Cells(logRow, 4).Value = mi.SenderEmailAddress
            logWs.Cells(logRow, 5).Value = at.FileName
            logWs.Cells(logRow, 6).Value = "Success"
            logWs.Cells(logRow, 7).Value = pdfPath

            logRow = logRow + 1

            On Error Resume Next

            If Not tempMail Is Nothing Then
                tempMail.Close 0
                Set tempMail = Nothing
            End If

            DoEvents
            Application.Wait Now + TimeValue("00:00:02")

            If Dir(tempMsgPath) <> "" Then
                Kill tempMsgPath
            End If

            On Error GoTo MainError

        Else

            errWs.Cells(errRow, 1).Value = errRow - 1
            errWs.Cells(errRow, 2).Value = Now
            errWs.Cells(errRow, 3).Value = mi.ReceivedTime
            errWs.Cells(errRow, 4).Value = mi.Subject
            errWs.Cells(errRow, 5).Value = "No PDF extracted"
            errWs.Cells(errRow, 6).Value = tempMsgPath
            errWs.Cells(errRow, 7).Value = "Extraction Failed"

            errRow = errRow + 1

        End If

    Next mi

    Unload frmProgress

    ws.Range("C15").Value = "Success"
    ws.Range("C16").Value = downloaded
    ws.Range("C17").Value = Now

    MsgBox downloaded & " PDF(s) downloaded successfully"

    Exit Sub

MainError:

    On Error Resume Next
    Unload frmProgress

    MsgBox "Error: " & Err.Description, vbCritical

End Sub


Function FindOutlookFolder(parentFolder As Object, targetName As String) As Object

    Dim subFolder As Object

    If LCase(Trim(parentFolder.Name)) = LCase(Trim(targetName)) Then
        Set FindOutlookFolder = parentFolder
        Exit Function
    End If

    For Each subFolder In parentFolder.Folders

        Set FindOutlookFolder = _
        FindOutlookFolder(subFolder, targetName)

        If Not FindOutlookFolder Is Nothing Then
            Exit Function
        End If

    Next subFolder

End Function