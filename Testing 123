$TestFolder = "$env:USERPROFILE\Desktop\PowerShell_Test"
New-Item -ItemType Directory -Force -Path $TestFolder | Out-Null

$Saved = $false

foreach ($mail in $Scans.Items)
{
    if ($mail.Class -eq 43)
    {
        foreach ($att in $mail.Attachments)
        {
            if ($att.FileName.ToLower().EndsWith(".pdf"))
            {
                $FilePath = Join-Path $TestFolder $att.FileName
                $att.SaveAsFile($FilePath)

                Write-Host "Downloaded successfully:"
                Write-Host $FilePath

                $Saved = $true
                break
            }
        }

        if ($Saved) { break }
    }
}

if (-not $Saved)
{
    Write-Host "No PDF attachments found in the Scans folder."
}