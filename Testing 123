' ============================================================
' BUILDER MACRO — Run this once in any Excel (Alt+F8)
' It will create a fully ready "Workfile Tracker Macro.xlsm"
' ============================================================

Sub BUILD_ReclamTracker()

    Dim newXL As Object
    Dim newWB As Object
    Dim newWBPath As String

    newWBPath = Environ("USERPROFILE") & "\Desktop\Workfile Tracker Macro.xlsm"

    Set newXL = CreateObject("Excel.Application")
    newXL.Visible = False
    Set newWB = newXL.Workbooks.Add

    Do While newWB.Sheets.Count > 1
        newWB.Sheets(newWB.Sheets.Count).Delete
    Loop

    newWB.Sheets(1).Name = "Home"

    Call BUILD_HomePage(newWB)
    Call INJECT_Module1_Constants(newWB)
    Call INJECT_Module2_Import(newWB)
    Call INJECT_Module3_Highlight(newWB)
    Call INJECT_Module4_OldTracker(newWB)
    Call INJECT_Module5_SheetOps(newWB)
    Call INJECT_Module6_Export(newWB)
    Call INJECT_HomePageCode(newWB)

    newWB.SaveAs newWBPath, 52
    newXL.Visible = True
    newWB.Activate

    MsgBox "SUCCESS! Your Workfile Tracker Macro has been created at:" & vbNewLine & newWBPath, vbInformation, "Builder Complete"

End Sub

