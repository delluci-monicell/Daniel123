        If cl = "I" Then ws.Cells(15, ci2 + 3).NumberFormat = "0.0"
        If cl = "J" Then ws.Cells(15, ci2 + 3).NumberFormat = "0.0%"
    Next ci2
    ws.Rows(15).RowHeight = 28

    ws.Range("A3").Select
    ActiveWindow.FreezePanes = True
