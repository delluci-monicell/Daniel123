Public Sub btnBrowseNew_Click()
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    fd.Title = "Select New Extract File"
    fd.Filters.Clear
    fd.Filters.Add "Excel Files", "*.xlsx;*.xlsm;*.xls"
    fd.AllowMultiSelect = False
    If fd.Show = -1 Then
        ThisWorkbook.Sheets("Home").Range("NewExtractPath").Value = fd.SelectedItems(1)
    End If
End Sub

Public Sub btnBrowseOld_Click()
    Dim fd As FileDialog
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    fd.Title = "Select Old Tracker File"
    fd.Filters.Clear
    fd.Filters.Add "Excel Files", "*.xlsx;*.xlsm;*.xls"
    fd.AllowMultiSelect = False
    If fd.Show = -1 Then
        ThisWorkbook.Sheets("Home").Range("OldTrackerPath").Value = fd.SelectedItems(1)
    End If
End Sub

Public Sub btnDownloadOld_Click()
    Dim oldPath As String
    oldPath = ThisWorkbook.Sheets("Home").Range("OldTrackerPath").Value
    If oldPath = "" Then
        MsgBox "Please browse and select the old tracker path first.", vbExclamation
        Exit Sub
    End If
    Workbooks.Open oldPath
End Sub

