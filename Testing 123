'========================
' Select folder dynamically
'========================

Dim rootFolder As Object
Dim foundFolder As Object

If Trim(sFldr) = "" Then
    MsgBox "Please enter Outlook folder name in C10.", vbExclamation
    Exit Sub
End If

Set foundFolder = Nothing

'Search entire Outlook mailbox recursively
For Each rootFolder In olNS.Folders

    Set foundFolder = FindOutlookFolder(rootFolder, sFldr)

    If Not foundFolder Is Nothing Then
        Exit For
    End If

Next rootFolder

If foundFolder Is Nothing Then
    MsgBox "Outlook folder not found: " & sFldr & vbCrLf & _
           "Check exact folder name in Outlook.", vbExclamation
    Exit Sub
End If

Set olFld = foundFolder





Function FindOutlookFolder(parentFolder As Object, targetName As String) As Object

    Dim subFolder As Object

    If LCase(Trim(parentFolder.Name)) = LCase(Trim(targetName)) Then
        Set FindOutlookFolder = parentFolder
        Exit Function
    End If

    For Each subFolder In parentFolder.Folders

        Set FindOutlookFolder = FindOutlookFolder(subFolder, targetName)

        If Not FindOutlookFolder Is Nothing Then
            Exit Function
        End If

    Next subFolder

End Function