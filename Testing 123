    AddKPI ws, 4, 13, "Stock" & Chr(10) & "Pending",    "=COUNTIF(" & trkr & "P3:P10002,""Stock Yet to be Renounced"")",              hCharcoal, 28
    AddKPI ws, 4, 15, "Stock" & Chr(10) & "Renounced",  "=COUNTIF(" & trkr & "P3:P10002,""Stock Renounced"")",                        hNavy,     28
    AddKPI ws, 4, 17, "Billing" & Chr(10) & "Pending",  "=COUNTIF(" & trkr & "P3:P10002,""Billing Yet to be Completed"")",            hPurple,   28
    AddKPI ws, 4, 19, "Completed",                       "=COUNTIF(" & trkr & "P3:P10002,""Process Completed"")",                     hGreen,    28
    ws.Rows(4).RowHeight = 55
    ws.Rows(5).RowHeight = 22

    StyleBanner ws, 6, 1, 20, "SLA & PERFORMANCE METRICS", hBlue, hWhite, 11, 28

    Dim cmpF As String
    cmpF = "COUNTIF(" & trkr & "P3:P10002,""Process Completed"")"
    Dim totF As String
    totF = "COUNTA(" & trkr & "B3:B10002)"

    AddKPI ws, 7, 1,  "SLA %" & Chr(10) & "Completed",     "=IFERROR(" & cmpF & "/" & totF & ",0)",                                              hGreen,    28, "0.0%"
    AddKPI ws, 7, 3,  "SLA" & Chr(10) & "Breached",         "=COUNTIF(" & trkr & "V3:V10002,""SLA Breached"")",                                   hRed,      28
    AddKPI ws, 7, 5,  "Due" & Chr(10) & "Today",            "=COUNTIF(" & trkr & "V3:V10002,""Due Today"")",                                       hOrange,   28
    AddKPI ws, 7, 7,  "Due" & Chr(10) & "Tomorrow",         "=COUNTIF(" & trkr & "V3:V10002,""Due Tomorrow"")",                                    hAmber,    28
    AddKPI ws, 7, 9,  "On Track",                            "=COUNTIF(" & trkr & "V3:V10002,""On Track"")",                                        hGreen,    28
    AddKPI ws, 7, 11, "Avg Resolution" & Chr(10) & "(Days)", "=IFERROR(AVERAGE(" & trkr & "Y3:Y10002),0)",                                         hBlue,     28, "0.0"
    AddKPI ws, 7, 13, "Avg Aging" & Chr(10) & "(Days)",     "=IFERROR(AVERAGE(" & trkr & "T3:T10002),0)",                                         hNavy,     28, "0.0"
    AddKPI ws, 7, 15, "Completion" & Chr(10) & "%",          "=IFERROR(" & cmpF & "/" & totF & ",0)",                                              hGreen,    28, "0.0%"
    AddKPI ws, 7, 17, "Oldest" & Chr(10) & "Aging",         "=IFERROR(MAX(" & trkr & "T3:T10002),0)",                                             hRed,      28
    AddKPI ws, 7, 19, "This Month",                          "=COUNTIFS(" & trkr & "B3:B10002,"">=""&DATE(YEAR(TODAY()),MONTH(TODAY()),1))",        hMidBlue,  28
    ws.Rows(7).RowHeight = 55
    ws.Rows(8).RowHeight = 22

    StyleBanner ws, 9, 1, 5, "STATUS BREAKDOWN", hNavy, hWhite, 11, 28
    StyleHdr ws.Cells(10, 1), "Status", hNavy, 10
    StyleHdr ws.Cells(10, 2), "Count",  hNavy, 10
    StyleHdr ws.Cells(10, 3), "% Share", hNavy, 10

    Dim statuses(8) As String
    statuses(0) = "New Request Received"
    statuses(1) = "Under Processing"
    statuses(2) = "Pending with Account Managers"
    statuses(3) = "Pending with Claimant"
    statuses(4) = "TV Dispatched to Claimant"
    statuses(5) = "Stock Yet to be Renounced"
    statuses(6) = "Stock Renounced"
    statuses(7) = "Billing Yet to be Completed"
    statuses(8) = "Process Completed"

    Dim r As Integer
    For r = 0 To 8
        Dim rowNum As Integer
        rowNum = 11 + r
        Dim bgCol As String
        If statuses(r) = "Process Completed" Then
            bgCol = hLtGreen
        ElseIf InStr(statuses(r), "Pending") > 0 Then
            bgCol = hSky
        Else
            bgCol = hOffWhite
        End If
        StyleBody ws.Cells(rowNum, 1), bgCol
        ws.Cells(rowNum, 1).Value = statuses(r)
        StyleBody ws.Cells(rowNum, 2), hOffWhite, True
        ws.Cells(rowNum, 2).Formula = "=COUNTIF(" & trkr & "P3:P10002,""" & statuses(r) & """)"
        ws.Cells(rowNum, 2).HorizontalAlignment = xlCenter
        StyleBody ws.Cells(rowNum, 3), hOffWhite
        ws.Cells(rowNum, 3).Formula = "=IFERROR(B" & rowNum & "/COUNTA(" & trkr & "B3:B10002),0)"
        ws.Cells(rowNum, 3).NumberFormat = "0.0%"
        ws.Cells(rowNum, 3).HorizontalAlignment = xlCenter
        ws.Rows(rowNum).RowHeight = 20
    Next r

    StyleBanner ws, 9, 7, 11, "BRANCH SUMMARY", hNavy, hWhite, 11, 28
    StyleHdr ws.Cells(10, 7), "Branch",    hBlue, 10
    StyleHdr ws.Cells(10, 8), "Total",     hBlue, 10
    StyleHdr ws.Cells(10, 9), "Completed", hBlue, 10
    StyleHdr ws.Cells(10, 10), "Breached", hBlue, 10

    Dim branches(9) As String
    branches(0)="Frankfurt": branches(1)="Hamburg": branches(2)="Munich"
    branches(3)="Berlin": branches(4)="Dusseldorf": branches(5)="Stuttgart"
    branches(6)="Cologne": branches(7)="Leipzig": branches(8)="Dresden"
    branches(9)="Hannover"

    For r = 0 To 9
        rowNum = 11 + r
        Dim brgBg As String
        If rowNum Mod 2 = 0 Then brgBg = hOffWhite Else brgBg = hWhite
        StyleBody ws.Cells(rowNum, 7), brgBg
        ws.Cells(rowNum, 7).Value = branches(r)
        StyleBody ws.Cells(rowNum, 8), brgBg, True
        ws.Cells(rowNum, 8).Formula = "=COUNTIF(" & trkr & "G3:G10002,""" & branches(r) & """)"
        ws.Cells(rowNum, 8).HorizontalAlignment = xlCenter
        StyleBody ws.Cells(rowNum, 9), brgBg
        ws.Cells(rowNum, 9).Formula = "=COUNTIFS(" & trkr & "G3:G10002,""" & branches(r) & """," & trkr & "P3:P10002,""Process Completed"")"
        ws.Cells(rowNum, 9).HorizontalAlignment = xlCenter
        StyleBody ws.Cells(rowNum, 10), brgBg
        ws.Cells(rowNum, 10).Formula = "=COUNTIFS(" & trkr & "G3:G10002,""" & branches(r) & """," & trkr & "V3:V10002,""SLA Breached"")"
        ws.Cells(rowNum, 10).HorizontalAlignment = xlCenter
        ws.Rows(rowNum).RowHeight = 20
    Next r

    StyleBanner ws, 9, 13, 17, "PROCESSOR SUMMARY", hNavy, hWhite, 11, 28
    StyleHdr ws.Cells(10, 13), "Processor", hBlue, 10
    StyleHdr ws.Cells(10, 14), "Total",     hBlue, 10
    StyleHdr ws.Cells(10, 15), "Completed", hBlue, 10
    StyleHdr ws.Cells(10, 16), "Breached",  hBlue, 10

    Dim procs(9) As String
    procs(0)="Harsha": procs(1)="Akshaya": procs(2)="Aishwarya"
    procs(3)="Nandhalakumar": procs(4)="Priya": procs(5)="Rajan"
    procs(6)="Divya": procs(7)="Suresh": procs(8)="Meena": procs(9)="Karthik"

    For r = 0 To 9
        rowNum = 11 + r
        Dim pBg As String
        If rowNum Mod 2 = 0 Then pBg = hOffWhite Else pBg = hWhite
        StyleBody ws.Cells(rowNum, 13), pBg
        ws.Cells(rowNum, 13).Value = procs(r)
        StyleBody ws.Cells(rowNum, 14), pBg, True
        ws.Cells(rowNum, 14).Formula = "=COUNTIF(" & trkr & "I3:I10002,""" & procs(r) & """)"
        ws.Cells(rowNum, 14).HorizontalAlignment = xlCenter
        StyleBody ws.Cells(rowNum, 15), pBg
        ws.Cells(rowNum, 15).Formula = "=COUNTIFS(" & trkr & "I3:I10002,""" & procs(r) & """," & trkr & "P3:P10002,""Process Completed"")"
        ws.Cells(rowNum, 15).HorizontalAlignment = xlCenter
        StyleBody ws.Cells(rowNum, 16), pBg
        ws.Cells(rowNum, 16).Formula = "=COUNTIFS(" & trkr & "I3:I10002,""" & procs(r) & """," & trkr & "V3:V10002,""SLA Breached"")"
        ws.Cells(rowNum, 16).HorizontalAlignment = xlCenter
        ws.Rows(rowNum).RowHeight = 20
    Next r

End Sub

