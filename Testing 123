Sub DownloadPDFAttachments()

    Dim ws As Worksheet
    Dim logWs As Worksheet
    Dim olApp As Object
    Dim olNS As Object
    Dim olFld As Object
    Dim items As Object
    Dim mi As Object
    Dim at As Object
    
    Dim sEmail As String
    Dim sPath As String
    Dim sFldr As String
    
    Dim dFrom As Date
    Dim dTo As Date
    Dim fStr As String
    
    Dim logRow As Long
    Dim dlCount As Long
    Dim failCount As Long
    Dim cnt As Long
    
    Dim senderAddr As String
    Dim fileName As String
    Dim fullPath As String
    
    On Error GoTo MainError
    
    Set ws = ThisWorkbook.Sheets("PDF Downloader")
    Set logWs = ThisWorkbook.Sheets("Download Log")
    
    '========================
    ' Read User Inputs
    '========================
    sEmail = Trim(ws.Cells(4, 3).Value)
    sPath = Trim(ws.Cells(7, 3).Value)
    sFldr = Trim(ws.Cells(8, 3).Value)
    
    If sEmail = "" Then
        MsgBox "Enter sender email in C4", vbExclamation
        Exit Sub
    End If
    
    If Not IsDate(ws.Cells(5, 3).Value) Then
        MsgBox "Enter valid Date From in C5", vbExclamation
        Exit Sub
    End If
    
    If Not IsDate(ws.Cells(6, 3).Value) Then
        MsgBox "Enter valid Date To in C6", vbExclamation
        Exit Sub
    End If
    
    dFrom = CDate(ws.Cells(5, 3).Value)
    dTo = CDate(ws.Cells(6, 3).Value)
    
    If dFrom > dTo Then
        MsgBox "Date From cannot be greater than Date To", vbExclamation
        Exit Sub
    End If
    
    If sPath = "" Then
        MsgBox "Select save folder first", vbExclamation
        Exit Sub
    End If
    
    If Right(sPath, 1) <> "\" Then
        sPath = sPath & "\"
    End If
    
    If Dir(sPath, vbDirectory) = "" Then
        MsgBox "Folder path not found", vbExclamation
        Exit Sub
    End If
    
    '========================
    ' Open Outlook
    '========================
    On Error Resume Next
    Set olApp = GetObject(, "Outlook.Application")
    On Error GoTo MainError
    
    If olApp Is Nothing Then
        Set olApp = CreateObject("Outlook.Application")
    End If
    
    Set olNS = olApp.GetNamespace("MAPI")
    olNS.Logon
    
    '========================
    ' Dynamic Folder Selection
    '========================
    If UCase(Trim(sFldr)) = "INBOX" Or Trim(sFldr) = "" Then
    
        Set olFld = olNS.GetDefaultFolder(6)
    
    Else
    
        Set olFld = Nothing
        
        Dim rootFolder As Object
        Dim subFolder As Object
        
        For Each rootFolder In olNS.Folders
        
            On Error Resume Next
            Set subFolder = rootFolder.Folders(sFldr)
            On Error GoTo 0
            
            If Not subFolder Is Nothing Then
                Set olFld = subFolder
                Exit For
            End If
        
        Next rootFolder
    
    End If
    
    If olFld Is Nothing Then
        MsgBox "Outlook folder not found: " & sFldr, vbExclamation
        Exit Sub
    End If
    
    '========================
    ' Filter Emails by Date
    '========================
    Application.StatusBar = "Filtering emails..."
    
    fStr = "[ReceivedTime] >= '" & Format(dFrom, "mm/dd/yyyy") & " 00:00 AM'" & _
           " AND [ReceivedTime] <= '" & Format(dTo, "mm/dd/yyyy") & " 11:59 PM'"
    
    Set items = olFld.Items.Restrict(fStr)
    items.Sort "[ReceivedTime]", False
    
    '========================
    ' Prepare Log
    '========================
    logRow = logWs.Cells(logWs.Rows.Count, 1).End(xlUp).Row + 1
    
    If logRow < 2 Then logRow = 2
    
    dlCount = 0
    failCount = 0
    cnt = 1
    
    '========================
    ' Process Emails
    '========================
    For Each mi In items
    
        If TypeName(mi) = "MailItem" Then
        
            senderAddr = ""
            
            On Error Resume Next
            senderAddr = mi.SenderEmailAddress
            On Error GoTo MainError
            
            If LCase(Trim(senderAddr)) = LCase(Trim(sEmail)) Then
            
                Application.StatusBar = "Processing email " & cnt
                
                If mi.Attachments.Count > 0 Then
                
                    For Each at In mi.Attachments
                    
                        If LCase(Right(at.FileName, 4)) = ".pdf" Then
                        
                            fileName = at.FileName
                            fullPath = sPath & fileName
                            
                            ' Handle duplicate file names
                            If Dir(fullPath) <> "" Then
                                fileName = Left(fileName, Len(fileName) - 4) & "_" & _
                                           Format(Now, "HHMMSS") & ".pdf"
                                fullPath = sPath & fileName
                            End If
                            
                            On Error Resume Next
                            at.SaveAsFile fullPath
                            
                            If Err.Number = 0 Then
                            
                                dlCount = dlCount + 1
                                
                                logWs.Cells(logRow, 1).Value = logRow - 1
                                logWs.Cells(logRow, 2).Value = Now
                                logWs.Cells(logRow, 3).Value = mi.Subject
                                logWs.Cells(logRow, 4).Value = senderAddr
                                logWs.Cells(logRow, 5).Value = fileName
                                logWs.Cells(logRow, 6).Value = "Downloaded"
                                logWs.Cells(logRow, 7).Value = fullPath
                            
                            Else
                            
                                failCount = failCount + 1
                                
                                logWs.Cells(logRow, 1).Value = logRow - 1
                                logWs.Cells(logRow, 2).Value = Now
                                logWs.Cells(logRow, 3).Value = mi.Subject
                                logWs.Cells(logRow, 4).Value = senderAddr
                                logWs.Cells(logRow, 5).Value = at.FileName
                                logWs.Cells(logRow, 6).Value = "Failed"
                                logWs.Cells(logRow, 7).Value = Err.Description
                            
                            End If
                            
                            Err.Clear
                            logRow = logRow + 1
                        
                        End If
                    
                    Next at
                
                End If
            
            End If
        
        End If
        
        cnt = cnt + 1
    
    Next mi
    
    '========================
    ' Final Status Update
    '========================
    Application.StatusBar = False
    
    ws.Cells(13, 3).Value = "Success"
    ws.Cells(14, 3).Value = dlCount
    ws.Cells(15, 3).Value = Now
    
    MsgBox "Download Complete!" & vbCrLf & vbCrLf & _
           "Downloaded: " & dlCount & vbCrLf & _
           "Failed: " & failCount, vbInformation
    
    Exit Sub

MainError:
    Application.StatusBar = False
    MsgBox "Error: " & Err.Description, vbCritical

End Sub