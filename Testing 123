'-----------------------------------
' Optional Time Logic
'-----------------------------------

If Trim(timeFrom) = "" Then

    startDateTime = DateValue(dFrom)

Else

    On Error Resume Next
    startDateTime = DateValue(dFrom) + TimeValue(timeFrom)
    
    If Err.Number <> 0 Then
        MsgBox "Invalid Time From." & vbCrLf & _
               "Use formats like:" & vbCrLf & _
               "14:30 OR 2:30 PM", vbExclamation
        Exit Sub
    End If
    
    On Error GoTo MainError

End If


If Trim(timeTo) = "" Then

    endDateTime = DateValue(dTo) + TimeValue("23:59:59")

Else

    On Error Resume Next
    endDateTime = DateValue(dTo) + TimeValue(timeTo)
    
    If Err.Number <> 0 Then
        MsgBox "Invalid Time To." & vbCrLf & _
               "Use formats like:" & vbCrLf & _
               "18:45 OR 6:45 PM", vbExclamation
        Exit Sub
    End If
    
    On Error GoTo MainError

End If