Private Sub DoSingleExport()

    Dim ZERO_CHECK_EXCLUDE As Variant
    ZERO_CHECK_EXCLUDE = GetZeroCheckExclude()

    Dim wsData As Worksheet, wsTemplate As Worksheet
    Dim lastRow As Long, r As Long, dupCounter As Long
    Dim seqNo As Variant
    Dim outputFolder As String, fileName As String, baseFileName As String, recordedFileName As String
    Dim account As String, isin As String, qty As String, payDateSafe As String
    Dim issueList As String, currentStatus As String
    Dim startTime As Double
    Dim doneCount As Long, failCount As Long, skipCount As Long, warnCount As Long
    Dim folderPicker As FileDialog
    Dim regenerateAll As VbMsgBoxResult

    regenerateAll = MsgBox("Regenerate ALL rows, even ones already exported?" & vbCrLf & vbCrLf & _
                            "Yes = regenerate everything (overwrites existing PDFs, rewrites Status)" & vbCrLf & _
                            "No = only export rows with a blank Status (skip anything already marked)", _
                            vbYesNoCancel + vbQuestion, "Rerun Mode")
    If regenerateAll = vbCancel Then Exit Sub

    Set folderPicker = Application.FileDialog(msoFileDialogFolderPicker)
    folderPicker.Title = "Select folder to save Credit Advice PDFs"
    folderPicker.AllowMultiSelect = False
    If folderPicker.Show <> -1 Then
        MsgBox "No folder selected. Batch cancelled.", vbExclamation
        Exit Sub
    End If
    outputFolder = folderPicker.SelectedItems(1)
    If Right(outputFolder, 1) <> "\" Then outputFolder = outputFolder & "\"

    Set wsData = ThisWorkbook.Sheets(DATA_SHEET)
    Set wsTemplate = ThisWorkbook.Sheets(TEMPLATE_SHEET)
    lastRow = wsData.Cells(wsData.Rows.Count, SEQ_DATA_COL).End(xlUp).Row

    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.DisplayAlerts = False
    startTime = Timer

    For r = 2 To lastRow
        seqNo = wsData.Cells(r, SEQ_DATA_COL).Value
        If seqNo = "" Then GoTo NextRow

        currentStatus = Trim(CStr(wsData.Cells(r, STATUS_COL).Value))
        If regenerateAll = vbNo And currentStatus <> "" Then
            skipCount = skipCount + 1
            GoTo NextRow
        End If

        wsTemplate.Range(SEQ_INPUT_CELL).Value = seqNo
        Application.CalculateFullRebuild   ' guarantees rows never bleed together

        recordedFileName = Trim(CStr(wsData.Cells(r, FILENAME_COL).Value))

        If recordedFileName <> "" Then
            ' This exact row already has its own established name — reuse it,
            ' so a regenerate overwrites only itself, never another row's file.
            fileName = recordedFileName
        Else
            ' First time this row has ever exported — build a fresh name and
            ' resolve collisions against whatever's already on disk. This is
            ' what correctly separates genuine duplicate-data rows into
            ' their own _v2, _v3, _v4 files instead of overwriting each other.
            account = CStr(wsTemplate.Range(ACCOUNT_CELL).Value)
            isin = CStr(wsTemplate.Range(ISIN_CELL).Value)
            qty = CStr(wsTemplate.Range(QTY_CELL).Value)
            payDateSafe = Replace(CStr(wsTemplate.Range(PAYDATE_CELL).Value), "/", "")
            baseFileName = CleanFileName(account & "_" & isin & "_" & qty & "_" & payDateSafe)

            fileName = baseFileName & ".pdf"
            dupCounter = 1
            Do While Dir(outputFolder & fileName) <> ""
                dupCounter = dupCounter + 1
                fileName = baseFileName & "_v" & dupCounter & ".pdf"
            Loop
        End If

        issueList = CheckFormulaIssues(wsTemplate, BLOCK_FIRST_ROW, BLOCK_LAST_ROW, ZERO_CHECK_EXCLUDE)

        wsTemplate.ExportAsFixedFormat _
            Type:=xlTypePDF, Filename:=outputFolder & fileName, _
            Quality:=xlQualityStandard, IncludeDocProperties:=False, _
            IgnorePrintAreas:=False, OpenAfterPublish:=False

        If Dir(outputFolder & fileName) = "" Then
            wsData.Cells(r, STATUS_COL).Value = "FAILED - PDF not found after export at SeqNo " & seqNo
            failCount = failCount + 1
        Else
            wsData.Cells(r, FILENAME_COL).Value = fileName   ' remember it for every future run

            If issueList <> "" Then
                wsData.Cells(r, STATUS_COL).Value = "DONE - CHECK DATA: " & issueList & Format(Now, "dd/mm/yyyy hh:nn:ss")
                warnCount = warnCount + 1
            Else
                wsData.Cells(r, STATUS_COL).Value = "DONE - " & Format(Now, "dd/mm/yyyy hh:nn:ss")
            End If
            doneCount = doneCount + 1
        End If

NextRow:
    Next r

CleanExit:
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True

    If Not ThisWorkbook.ReadOnly Then
        On Error Resume Next
        ThisWorkbook.Save
        On Error GoTo 0
    Else
        MsgBox "This workbook is open Read-Only, so Status and filename records just written " & _
               "will NOT be saved. Save a writable copy if you need this to persist.", vbExclamation
    End If

    MsgBox "Finished in " & Format(Timer - startTime, "0.0") & " sec." & vbCrLf & _
           "Saved: " & doneCount & " (flagged for review: " & warnCount & ")" & vbCrLf & _
           "Failed: " & failCount & "   Skipped: " & skipCount & vbCrLf & _
           "Folder: " & outputFolder, vbInformation
End Sub
