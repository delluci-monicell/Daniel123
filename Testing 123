    ws.Range("T3:T10002").FormulaR1C1 = _
        "=IF(RC[-18]="""","""",IF(RC[-4]=""Process Completed""," & _
        "NETWORKDAYS(RC[-18],RC[4])-1,NETWORKDAYS(RC[-18],TODAY())-1))"

    ws.Range("U3:U10002").FormulaR1C1 = _
        "=IF(RC[-19]="""","""",IF(RC[-5]=""Process Completed"",0," & _
        "NETWORKDAYS(TODAY(),RC[-2])-1))"

    ws.Range("V3:V10002").FormulaR1C1 = _
