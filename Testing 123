    AddKPI ws, 4, 7,  "Pending" & Chr(10) & "A/M",      "=COUNTIF(" & trkr & "P3:P10002,""Pending with Account Managers"")",          hTeal,     28
    AddKPI ws, 4, 9,  "Pending" & Chr(10) & "Claimant", "=COUNTIF(" & trkr & "P3:P10002,""Pending with Claimant"")",                  hMidBlue,  28
