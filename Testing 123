    ' Search ALL top-level folders in the mailbox (not just under Inbox)
    Dim store As Object
    Dim rootFolder As Object
    Dim found As Boolean
    found = False

    Set store = olNs.Stores(1) ' Primary mailbox
    Set rootFolder = store.GetRootFolder()

    For Each f In rootFolder.Folders
        If LCase(Trim(f.Name)) = LCase(Trim(outlookFolder)) Then
            Set targetFolder = f
            found = True
            Exit For
        End If
    Next f

    If Not found Then
        MsgBox "Outlook folder '" & outlookFolder & "' not found.", vbCritical
        Exit Sub
    End If
