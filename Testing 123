Option Explicit

' ================================================================
' SWIFT MT MESSAGE PARSER — DOUBLE BUILDER
' ================================================================
' HOW TO USE:
'   1. Open any Excel file
'   2. Press ALT+F11 → Insert → Module
'   3. Paste this entire code
'   4. Press ALT+F8 → Select "BuildSWIFTParserFile" → Run
'   5. Choose where to save → Done
'
' The new file created needs ZERO SWIFT knowledge from the user.
' They just paste any message → click DECODE → read plain English.
' ================================================================

Public Sub BuildSWIFTParserFile()

    Dim savePath As String
    savePath = Application.GetSaveAsFilename( _
        InitialFileName:="SWIFT_Message_Parser", _
        FileFilter:="Excel Macro-Enabled Workbook (*.xlsm),*.xlsm", _
        Title:="Choose where to save your new SWIFT Parser file")

    If savePath = "False" Or Len(savePath) = 0 Then
        MsgBox "Cancelled.", vbInformation: Exit Sub
    End If

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    Dim wb As Workbook
    Set wb = Workbooks.Add
    Do While wb.Sheets.Count > 1
        wb.Sheets(wb.Sheets.Count).Delete
    Loop

    Call MakeCoverSheet(wb)
    Call MakeParserSheet(wb)
    Call MakeSamplesSheet(wb)

    On Error Resume Next
    wb.Sheets("Sheet1").Delete
    wb.Sheets("Tabelle1").Delete
    wb.Sheets("Feuil1").Delete
    On Error GoTo 0

    Dim vbp As Object
    Set vbp = wb.VBProject

    Dim m1 As Object
    Set m1 = vbp.VBComponents.Add(1)
    m1.Name = "SWIFT_Parser"
    m1.CodeModule.AddFromString BuildParserCode()

    Dim m2 As Object
    Set m2 = vbp.VBComponents.Add(1)
    m2.Name = "PDF_Reader"
    m2.CodeModule.AddFromString BuildPDFCode()

    Call AddButtons(wb)

    wb.SaveAs Filename:=savePath, FileFormat:=xlOpenXMLWorkbookMacroEnabled
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True

    MsgBox "DONE! Your SWIFT Parser file has been created." & Chr(13) & Chr(13) & _
           "Location: " & savePath & Chr(13) & Chr(13) & _
           "How to use the new file:" & Chr(13) & _
           "  1. Go to the PARSER sheet" & Chr(13) & _
           "  2. Paste any SWIFT message in the yellow box" & Chr(13) & _
           "  3. Click the green  DECODE THIS MESSAGE  button" & Chr(13) & _
           "  4. Read the full plain-English explanation below" & Chr(13) & Chr(13) & _
           "No SWIFT knowledge needed at all!", _
           vbInformation, "Parser Created Successfully"
    wb.Activate
End Sub

' ================================================================
' ADD BUTTONS
' ================================================================
Private Sub AddButtons(wb As Workbook)
    Dim ws As Worksheet
    For Each ws In wb.Sheets
        If ws.Name = "PARSER" Then
            Dim b1 As Object
            Set b1 = ws.Buttons.Add(ws.Range("B3").Left, ws.Range("B3").Top, 165, 24)
            b1.Caption = "  DECODE THIS MESSAGE"
            b1.OnAction = "SWIFT_Parser.DecodeMessage"
            b1.Characters.Font.Name = "Arial"
            b1.Characters.Font.Bold = True
            b1.Characters.Font.Size = 10

            Dim b2 As Object
            Set b2 = ws.Buttons.Add(ws.Range("B3").Left + 175, ws.Range("B3").Top, 140, 24)
            b2.Caption = "  IMPORT FROM PDF"
            b2.OnAction = "PDF_Reader.ImportFromPDF"
            b2.Characters.Font.Name = "Arial"
            b2.Characters.Font.Size = 9

            Dim b3 As Object
            Set b3 = ws.Buttons.Add(ws.Range("B3").Left + 325, ws.Range("B3").Top, 90, 24)
            b3.Caption = "  CLEAR"
            b3.OnAction = "SWIFT_Parser.ClearAll"
            b3.Characters.Font.Name = "Arial"
            b3.Characters.Font.Size = 9
            Exit For
        End If
    Next ws
End Sub

