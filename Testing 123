        .Value = "  Ready — paste a SWIFT message above and click  DECODE THIS MESSAGE"
        .Font.Name = "Arial": .Font.Size = 9: .Font.Italic = True
        .Interior.Color = RGB(213, 245, 227): .IndentLevel = 1
    End With

    ws.Rows(202).RowHeight = 16
    ws.Range("B202:E202").Merge
    With ws.Range("B202")
        .Font.Name = "Arial": .Font.Size = 8: .Font.Color = RGB(41, 128, 185)
        .Interior.Color = RGB(214, 234, 248)
    End With
