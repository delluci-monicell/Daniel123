Private Sub btnImport_Click()
    Me.Range("LastPerformedBy").Value = Environ("USERNAME")
    Me.Range("LastPerformedOn").Value = Now()
    
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    
    Call ImportAndClean
    Call HighlightAndFilter
    Call LookupFromOldTracker
    Call SheetOperations
    
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    
    MsgBox "Workfile Tracker processed successfully!" & vbNewLine & _
           "Performed by: " & Environ("USERNAME") & vbNewLine & _
           "Date: " & Format(Now(), "DD/MM/YYYY HH:MM"), _
           vbInformation, "Process Complete"
End Sub
