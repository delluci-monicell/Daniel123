Option Explicit

Sub DownloadAttachments()

    '=== SHEETS ===
    Dim ws As Worksheet
    Dim logWs As Worksheet
    Dim errWs As Worksheet
    Set ws = ThisWorkbook.Sheets("PDF Downloader")
    Set logWs = ThisWorkbook.Sheets("Download Log")
    Set errWs = ThisWorkbook.Sheets("Error Log")

    '=== READ SETTINGS ===
    Dim senderEmail As String
    Dim sPath As String
    Dim outlookFolder As String
    Dim fromDateTime As Date
    Dim toDateTime As Date

    On Error GoTo ReadError
    senderEmail = LCase(Trim(ws.Range("C4").Value))
    sPath = Trim(ws.Range("C9").Value)
    outlookFolder = Trim(ws.Range("C10").Value)

    '=== READ DATE AND TIME DIRECTLY FROM CELL — NO CONVERSION ===
    fromDateTime = ws.Range("C5").Value + ws.Range("C6").Value
    toDateTime = ws.Range("C7").Value + ws.Range("C8").Value
    On Error GoTo 0

    If Right(sPath, 1) <> "\" Then sPath = sPath & "\"
    If Dir(sPath, vbDirectory) = "" Then
        MsgBox "Save folder not found: " & sPath, vbCritical
        Exit Sub
    End If

    '=== START TIMER ===
    Dim startTime As Double
    startTime = Timer

    '=== CONNECT OUTLOOK ===
    Dim olApp As Object
    Dim olNs As Object
    On Error GoTo OutlookError
    Set olApp = CreateObject("Outlook.Application")
    Set olNs = olApp.GetNamespace("MAPI")
    olNs.Logon
    On Error GoTo 0

    '=== FIND FOLDER ===
    Dim targetFolder As Object
    Dim mb As Object
    Dim f As Object
    Dim subF As Object
    Dim found As Boolean
    found = False

    For Each mb In olNs.Folders
        For Each f In mb.Folders
            If LCase(Trim(f.Name)) = LCase(outlookFolder) Then
                Set targetFolder = f
                found = True
                Exit For
            End If
            For Each subF In f.Folders
                If LCase(Trim(subF.Name)) = LCase(outlookFolder) Then
                    Set targetFolder = subF
                    found = True
                    Exit For
                End If
            Next subF
            If found Then Exit For
        Next f
        If found Then Exit For
    Next mb

    If Not found Then
        Dim folderList As String
        folderList = ""
        For Each mb In olNs.Folders
            For Each f In mb.Folders
                folderList = folderList & "  - " & f.Name & vbNewLine
            Next f
        Next mb
        MsgBox "Folder '" & outlookFolder & "' not found." & vbNewLine & "Available:" & vbNewLine & folderList, vbCritical
        Exit Sub
    End If

    '=== DASL FILTER ===
    Dim fromUTC As Date
    Dim toUTC As Date
    fromUTC = fromDateTime - (8 / 24)
    toUTC = toDateTime - (8 / 24)

    Dim filter As String
    filter = "@SQL=""urn:schemas:httpmail:datereceived"" >= '" & Format(fromUTC, "yyyy-mm-ddThh:mm:ss") & "Z' AND ""urn:schemas:httpmail:datereceived"" <= '" & Format(toUTC, "yyyy-mm-ddThh:mm:ss") & "Z'"

    Dim allItems As Object
    Set allItems = targetFolder.Items
    allItems.Sort "[ReceivedTime]", False

    Dim filteredItems As Object
    Set filteredItems = allItems.Restrict(filter)

    '=== FAST PRE-COUNT ===
    frmProgress.lblStatus.Caption = "Counting emails..."
    frmProgress.lblEmailCount.Caption = "Please wait..."
    frmProgress.lblDownloadCount.Caption = "Attachments Downloaded: 0"
    frmProgress.lblBar.Width = 0
    frmProgress.Show vbModeless
    DoEvents

    Dim totalEmails As Long
    totalEmails = 0
    Dim mi As Object

    For Each mi In filteredItems
        If TypeName(mi) = "MailItem" Then
            If LCase(Trim(mi.SenderEmailAddress)) = senderEmail Then
                totalEmails = totalEmails + 1
            End If
        End If
    Next mi

    frmProgress.lblStatus.Caption = "Starting download..."
    frmProgress.lblEmailCount.Caption = "0 / " & totalEmails & " Emails Processed"
    DoEvents

    '=== LOG ROW POINTERS ===
    Dim logRow As Long
    Dim errRow As Long
    logRow = logWs.Cells(logWs.Rows.Count, 1).End(xlUp).Row + 1
    errRow = errWs.Cells(errWs.Rows.Count, 1).End(xlUp).Row + 1

    '=== COUNTERS ===
    Dim downloaded As Long
    Dim processed As Long
    downloaded = 0
    processed = 0

    '=== TEMP FILE TRACKER ===
    Dim tempFiles() As String
    Dim tempFileCount As Long
    tempFileCount = 0

    '=== VARIABLES ===
    Dim tempMail As Object
    Dim at As Object
    Dim tempMsgPath As String
    Dim savePath As String
    Dim pdfSaved As Boolean
    Dim progressPct As Double

    '=== MAIN LOOP ===
    For Each mi In filteredItems

        If TypeName(mi) <> "MailItem" Then GoTo NextMail
        If LCase(Trim(mi.SenderEmailAddress)) <> senderEmail Then GoTo NextMail

        processed = processed + 1

        '--- Update progress ---
        progressPct = processed / totalEmails
        If progressPct > 1 Then progressPct = 1
        frmProgress.lblStatus.Caption = "Processing " & processed & " of " & totalEmails
        frmProgress.lblEmailCount.Caption = processed & " / " & totalEmails & " Emails Processed"
        frmProgress.lblBar.Width = Int(frmProgress.fraProgress.InsideWidth * progressPct)
        DoEvents

        '--- Skip if no attachments ---
        If mi.Attachments.Count = 0 Then
            Call LogError(errWs, errRow, Now, mi.ReceivedTime, mi.Subject, "", "", "No Attachments Found", "")
            errRow = errRow + 1
            GoTo NextMail
        End If

        '--- Save temp MSG ---
        tempMsgPath = sPath & "TEMP_" & Format(Now, "yyyymmdd_hhnnss") & "_" & processed & ".msg"

        On Error Resume Next
        mi.SaveAs tempMsgPath, 3
        If Err.Number <> 0 Then
            Call LogError(errWs, errRow, Now, mi.ReceivedTime, mi.Subject, "", tempMsgPath, "MSG Save Failed: " & Err.Description, "")
            errRow = errRow + 1
            Err.Clear
            GoTo NextMail
        End If
        On Error GoTo 0

        '--- Open temp MSG ---
        Set tempMail = Nothing
        On Error Resume Next
        Set tempMail = olApp.Session.OpenSharedItem(tempMsgPath)
        If Err.Number <> 0 Or tempMail Is Nothing Then
            Call LogError(errWs, errRow, Now, mi.ReceivedTime, mi.Subject, "", tempMsgPath, "MSG Open Failed: " & Err.Description, "")
            errRow = errRow + 1
            Err.Clear
            GoTo CleanTemp
        End If
        On Error GoTo 0

        pdfSaved = False

        '--- Save attachments ---
        For Each at In tempMail.Attachments
            If LCase(Right(at.FileName, 4)) <> ".pdf" Then GoTo NextAttachment

            savePath = sPath & at.FileName
            If Dir(savePath) <> "" Then
                savePath = sPath & Format(Now, "yyyymmdd_hhnnss_") & processed & "_" & at.FileName
            End If

            On Error Resume Next
            at.SaveAsFile savePath
            If Err.Number <> 0 Then
                Call LogError(errWs, errRow, Now, mi.ReceivedTime, mi.Subject, at.FileName, tempMsgPath, "Save Failed: " & Err.Description, savePath)
                errRow = errRow + 1
                Err.Clear
            Else
                downloaded = downloaded + 1
                pdfSaved = True
                logWs.Cells(logRow, 1).Value = logRow - 1
                logWs.Cells(logRow, 2).Value = Now
                logWs.Cells(logRow, 3).Value = mi.Subject
                logWs.Cells(logRow, 4).Value = mi.SenderEmailAddress
                logWs.Cells(logRow, 5).Value = at.FileName
                logWs.Cells(logRow, 6).Value = "Success"
                logWs.Cells(logRow, 7).Value = savePath
                logRow = logRow + 1
                frmProgress.lblDownloadCount.Caption = "Attachments Downloaded: " & downloaded
                DoEvents
            End If
            On Error GoTo 0

NextAttachment:
        Next at

        If Not pdfSaved Then
            Call LogError(errWs, errRow, Now, mi.ReceivedTime, mi.Subject, "", tempMsgPath, "No PDF Attachments Found", "")
            errRow = errRow + 1
        End If

CleanTemp:
        On Error Resume Next
        Set at = Nothing
        If Not tempMail Is Nothing Then
            tempMail.Close 0
            Set tempMail = Nothing
        End If
        DoEvents

        If tempMsgPath <> "" Then
            tempFileCount = tempFileCount + 1
            ReDim Preserve tempFiles(1 To tempFileCount)
            tempFiles(tempFileCount) = tempMsgPath
        End If
        On Error GoTo 0

NextMail:
    Next mi

    '=== FINAL PROGRESS UPDATE ===
    frmProgress.lblStatus.Caption = "Completed!"
    frmProgress.lblEmailCount.Caption = processed & " / " & totalEmails & " Emails Processed"
    frmProgress.lblDownloadCount.Caption = "Attachments Downloaded: " & downloaded
    frmProgress.lblBar.Width = frmProgress.fraProgress.InsideWidth
    DoEvents
    Application.Wait Now + TimeValue("00:00:01")
    Unload frmProgress

    '=== ELAPSED TIME ===
    Dim elapsedSec As Long
    elapsedSec = CLng(Timer - startTime)
    Dim hrs As Long
    Dim mins As Long
    Dim secs As Long
    hrs = elapsedSec \ 3600
    mins = (elapsedSec Mod 3600) \ 60
    secs = elapsedSec Mod 60

    '=== UPDATE SHEET ===
    ws.Range("C15").Value = "Success"
    ws.Range("C16").Value = downloaded
    ws.Range("C17").Value = Now
    ws.Range("C18").Value = Format(hrs, "00") & "h " & Format(mins, "00") & "m " & Format(secs, "00") & "s"

    '=== SUCCESS MESSAGE ===
    MsgBox downloaded & " attachment(s) downloaded from " & processed & " of " & totalEmails & " matching email(s)." & vbNewLine & vbNewLine & "Time taken: " & Format(hrs, "00") & "h " & Format(mins, "00") & "m " & Format(secs, "00") & "s" & vbNewLine & vbNewLine & "Please click OK and wait 2 to 5 seconds." & vbNewLine & "Temporary email files will be deleted automatically.", vbInformation, "Download Complete"

    '=== TRIGGER CLEANUP ===
    If tempFileCount > 0 Then
        Call CleanupTempFiles(tempFiles, tempFileCount)
    End If

    Exit Sub

ReadError:
    ws.Range("C15").Value = "Failed"
    ws.Range("C17").Value = Now
    MsgBox "Error reading settings. Check C4 to C10." & vbNewLine & Err.Description, vbCritical
    Exit Sub

OutlookError:
    ws.Range("C15").Value = "Failed"
    ws.Range("C17").Value = Now
    MsgBox "Cannot connect to Outlook. Make sure it is open." & vbNewLine & Err.Description, vbCritical
    Exit Sub

End Sub

'=== LOG ERROR HELPER ===
Sub LogError(errWs As Worksheet, errRow As Long, macroTime As Date, _
             receivedTime As Variant, subject As String, attachName As String, _
             msgPath As String, reason As String, fullPath As String)
    errWs.Cells(errRow, 1).Value = errRow - 1
    errWs.Cells(errRow, 2).Value = macroTime
    errWs.Cells(errRow, 3).Value = receivedTime
    errWs.Cells(errRow, 4).Value = subject
    errWs.Cells(errRow, 5).Value = attachName
    errWs.Cells(errRow, 6).Value = msgPath
    errWs.Cells(errRow, 7).Value = reason
    errWs.Cells(errRow, 8).Value = fullPath
End Sub
