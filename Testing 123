Sub AddRefundFlagColumn(l2WS As Worksheet)
    Dim l2LastRow As Long
    Dim r As Long
    Dim amt As Variant
    Dim isOver As Boolean

    ' Insert new column before H -> old H shifts to I, old AE (refund amount) shifts to AF
    l2WS.Columns("H:H").Insert Shift:=xlToRight
    l2WS.Cells(HEADER_ROW, 8).Value = "Refund > 10,000"

    l2LastRow = l2WS.Cells(l2WS.Rows.Count, "D").End(xlUp).Row

    For r = DATA_START_ROW To l2LastRow
        amt = l2WS.Cells(r, "AF").Value
        If IsNumeric(amt) Then
            isOver = (CDbl(amt) > 10000)
            l2WS.Cells(r, "H").Value = isOver
            If isOver Then
                l2WS.Cells(r, "H").Interior.Color = RGB(255, 229, 153)
            Else
                l2WS.Cells(r, "H").Interior.Pattern = xlNone
            End If
        End If
    Next r
End Sub
