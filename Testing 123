pdfSaved = False

'========================
' Loop through attachments
'========================
For Each at In tempMail.Attachments

    If LCase(Right(at.FileName, 4)) = ".pdf" Then
        
        pdfPath = sPath & at.FileName
        
        If Dir(pdfPath) <> "" Then
            pdfPath = sPath & Format(Now, "yyyymmdd_hhnnss_") & at.FileName
        End If
        
        at.SaveAsFile pdfPath
        
        downloaded = downloaded + 1
        pdfSaved = True
        
        ' Download log
        logWs.Cells(logRow, 1).Value = logRow - 1
        logWs.Cells(logRow, 2).Value = Now
        logWs.Cells(logRow, 3).Value = mi.Subject
        
        If mi.SenderEmailAddress <> "" Then
            logWs.Cells(logRow, 4).Value = mi.SenderEmailAddress
        Else
            logWs.Cells(logRow, 4).Value = "Unknown Sender"
        End If
        
        logWs.Cells(logRow, 5).Value = at.FileName
        logWs.Cells(logRow, 6).Value = "Success"
        logWs.Cells(logRow, 7).Value = pdfPath
        
        logRow = logRow + 1
        
    End If

Next at


'========================
' Delete temp MSG if PDF saved
'========================
If pdfSaved = True Then
    
    On Error Resume Next
    
    Set at = Nothing
    
    If Not tempMail Is Nothing Then
        tempMail.Close 0
        Set tempMail = Nothing
    End If
    
    DoEvents
    Application.Wait Now + TimeValue("00:00:02")
    
    If Dir(tempMsgPath) <> "" Then
        Kill tempMsgPath
    End If
    
    On Error GoTo MainError

Else

    ' Error log
    errWs.Cells(errRow, 1).Value = errRow - 1
    errWs.Cells(errRow, 2).Value = Now
    
    If Not mi Is Nothing Then
        errWs.Cells(errRow, 3).Value = mi.ReceivedTime
        errWs.Cells(errRow, 4).Value = mi.Subject
    Else
        errWs.Cells(errRow, 3).Value = "Unknown Time"
        errWs.Cells(errRow, 4).Value = "Unknown Subject"
    End If
    
    If Not at Is Nothing Then
        errWs.Cells(errRow, 5).Value = at.FileName
    Else
        errWs.Cells(errRow, 5).Value = "No Attachment Found"
    End If
    
    errWs.Cells(errRow, 6).Value = Dir(tempMsgPath)
    errWs.Cells(errRow, 7).Value = "No PDF attachment found"
    errWs.Cells(errRow, 8).Value = tempMsgPath
    
    errRow = errRow + 1

End If


NextMail:
Next mi