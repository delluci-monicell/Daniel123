Option Explicit

Sub CleanupTempFiles(tempFiles() As String, tempFileCount As Long)

    Dim i As Long
    Dim retry As Integer
    Dim deleteFailed As Long
    Dim failedList As String
    deleteFailed = 0
    failedList = ""

    For i = 1 To tempFileCount

        If tempFiles(i) = "" Then GoTo NextFile
        If Dir(tempFiles(i)) = "" Then GoTo NextFile

        retry = 0

        On Error Resume Next
        Do While Dir(tempFiles(i)) <> "" And retry < 5
            Err.Clear
            Kill tempFiles(i)
            If Err.Number <> 0 Then
                retry = retry + 1
                Application.Wait Now + TimeValue("00:00:01")
                DoEvents
            Else
                Exit Do
            End If
        Loop
        On Error GoTo 0

        If Dir(tempFiles(i)) <> "" Then
            deleteFailed = deleteFailed + 1
            failedList = failedList & tempFiles(i) & vbNewLine
        End If

NextFile:
    Next i

    If deleteFailed > 0 Then
        MsgBox deleteFailed & " temp file(s) could not be deleted." & _
               vbNewLine & vbNewLine & _
               "Please manually delete these files:" & _
               vbNewLine & failedList, _
               vbExclamation, "Cleanup Warning"
    End If

End Sub


