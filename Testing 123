Sub CopyVisibleToSheet(ws As Worksheet, destWS As Worksheet, lastRow As Long)
    Dim visRng As Range
    Dim destRow As Long
    Dim cell As Range
    On Error Resume Next
    For Each cell In ws.Range("A7:A" & lastRow).SpecialCells(xlCellTypeVisible)
        If cell.Value <> "" Or ws.Cells(cell.Row, "D").Value <> "" Then
            If visRng Is Nothing Then
                Set visRng = cell.EntireRow
            Else
                Set visRng = Union(visRng, cell.EntireRow)
            End If
        End If
    Next cell
    On Error GoTo 0
    If visRng Is Nothing Then Exit Sub
    destRow = destWS.Cells(destWS.Rows.Count, "A").End(xlUp).Row + 1
    visRng.Copy
    destWS.Cells(destRow, 1).PasteSpecial Paste:=xlPasteAll
    destWS.Cells(destRow, 1).PasteSpecial Paste:=xlPasteColumnWidths
    Application.CutCopyMode = False
End Sub
