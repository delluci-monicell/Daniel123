Option Explicit

Public Const SHEET_NAME As String = "Home"
Public Const FIRST_ROW As Long = 3

Sub LoadXML()
    Dim ws As Worksheet
    Dim fPath As Variant
    Dim stm As Object
    Dim txt As String
    Dim lines() As String
    Dim i As Long

    Set ws = ThisWorkbook.Worksheets(SHEET_NAME)

    fPath = Application.GetOpenFilename("XML Files (*.xml),*.xml", , "Select XML file")
    If fPath = False Then Exit Sub

    ' Read file as UTF-8
    Set stm = CreateObject("ADODB.Stream")
    With stm
        .Type = 2              ' text
        .Charset = "UTF-8"
        .Open
        .LoadFromFile CStr(fPath)
        txt = .ReadText
        .Close
    End With

    ' Remove BOM character if present
    If Len(txt) > 0 Then
        If AscW(Left$(txt, 1)) = &HFEFF Then txt = Mid$(txt, 2)
    End If

    ' Normalise line endings, then split
    txt = Replace(txt, vbCrLf, vbLf)
    txt = Replace(txt, vbCr, vbLf)
    lines = Split(txt, vbLf)

    Application.ScreenUpdating = False

    ' Clear old content
    ws.Range("A" & FIRST_ROW & ":B" & ws.Rows.Count).Clear

    ws.Range("A1").Value = "XML File Path"
    ws.Range("B1").Value = CStr(fPath)
    ws.Range("A2").Value = "Line #"
    ws.Range("B2").Value = "XML Content"

    ' Write as text so Excel does not convert anything
    ws.Range("B" & FIRST_ROW & ":B" & FIRST_ROW + UBound(lines)).NumberFormat = "@"

    For i = 0 To UBound(lines)
        ws.Cells(FIRST_ROW + i, 1).Value = i + 1
        ws.Cells(FIRST_ROW + i, 2).Value = lines(i)
    Next i

    ' Keep indentation visible
    With ws.Range("B" & FIRST_ROW & ":B" & FIRST_ROW + UBound(lines))
        .Font.Name = "Consolas"
        .HorizontalAlignment = xlLeft
        .WrapText = False
    End With

    Application.ScreenUpdating = True
    MsgBox "Loaded " & UBound(lines) + 1 & " lines.", vbInformation
End Sub
