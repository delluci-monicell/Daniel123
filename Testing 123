errRow = errRow + 1

End If                 ' closes: If Not at Is Nothing Then / Else block

End If                 ' closes: If TypeName(mi) = "MailItem" Then

NextMail:
Next mi                ' closes: For Each mi In filteredItems

Unload frmProgress

ws.Range("C15").Value = "Success"
ws.Range("C16").Value = downloaded
ws.Range("C17").Value = Now

MsgBox downloaded & " PDF(s) downloaded successfully.", vbInformation

Exit Sub