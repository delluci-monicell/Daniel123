Option Explicit

Sub DownloadPDFAttachments()

    On Error GoTo MainError

    Dim ws As Worksheet
    Dim logWs As Worksheet
    Dim errWs As Worksheet

    Set ws = Sheets("PDF Downloader")
    Set logWs = Sheets("Download Log")
    Set errWs = Sheets("Error Log")

    Dim senderEmail As String
    Dim savePath As String
    Dim folderName As String

    Dim fromDate As Date
    Dim toDate As Date
    Dim fromTime As Date
    Dim toTime As Date
    Dim finalFrom As Date
    Dim finalTo As Date

    senderEmail = LCase(Trim(ws.Range("C4").Value))
    savePath = Trim(ws.Range("C9").Value)
    folderName = Trim(ws.Range("C10").Value)

    If Right(savePath, 1) <> "\" Then savePath = savePath & "\"

    If Dir(savePath, vbDirectory) = "" Then
        MsgBox "Save folder path not found.", vbCritical
        Exit Sub
    End If

    fromDate = ws.Range("C5").Value
    toDate = ws.Range("C7").Value

    If Trim(ws.Range("C6").Text) = "" Then
        fromTime = TimeValue("00:00:00")
    Else
        fromTime = TimeValue(ws.Range("C6").Text)
    End If

    If Trim(ws.Range("C8").Text) = "" Then
        toTime = TimeValue("23:59:59")
    Else
        toTime = TimeValue(ws.Range("C8").Text)
    End If

    finalFrom = fromDate + fromTime
    finalTo = toDate + toTime

    '-------------------------------
    ' Open Outlook
    '-------------------------------
    Dim olApp As Object
    Dim olNamespace As Object
    Dim rootFolder As Object
    Dim targetFolder As Object

    On Error Resume Next
    Set olApp = GetObject(, "Outlook.Application")

    If olApp Is Nothing Then
        Set olApp = CreateObject("Outlook.Application")
    End If
    On Error GoTo MainError

    Set olNamespace = olApp.GetNamespace("MAPI")
    Set rootFolder = olNamespace.Folders.Item(1)

    Set targetFolder = FindOutlookFolder(rootFolder, folderName)

    If targetFolder Is Nothing Then
        MsgBox "Outlook folder not found: " & folderName, vbCritical
        Exit Sub
    End If

    Dim items As Object
    Dim filteredItems As Object

    Set items = targetFolder.Items
    items.Sort "[ReceivedTime]", True

    Set filteredItems = items.Restrict( _
        "[ReceivedTime] >= '" & Format(finalFrom, "ddddd h:nn AMPM") & _
        "' AND [ReceivedTime] <= '" & Format(finalTo, "ddddd h:nn AMPM") & "'")

    If filteredItems.Count = 0 Then
        MsgBox "No emails found in selected range.", vbInformation
        Exit Sub
    End If

    '-------------------------------
    ' Progress Form
    '-------------------------------
    frmProgress.lblStatus.Caption = "Preparing Emails..."
    frmProgress.lblEmailCount.Caption = "0 / " & filteredItems.Count & " Emails Processed"
    frmProgress.lblDownloadedCount.Caption = "PDFs Downloaded: 0"
    frmProgress.lblBar.Width = 0

    frmProgress.Show vbModeless
    DoEvents

    '-------------------------------
    ' Logging
    '-------------------------------
    Dim logRow As Long
    Dim errRow As Long

    logRow = logWs.Cells(logWs.Rows.Count, 1).End(xlUp).Row + 1
    errRow = errWs.Cells(errWs.Rows.Count, 1).End(xlUp).Row + 1

    Dim processed As Long
    Dim downloaded As Long

    Dim mi As Object
    Dim at As Object
    Dim tempMail As Object

    Dim tempMsgPath As String
    Dim pdfPath As String
    Dim pdfSaved As Boolean

    For Each mi In filteredItems

        If TypeName(mi) = "MailItem" Then

            If LCase(Trim(mi.SenderEmailAddress)) <> senderEmail Then
                GoTo NextMail
            End If

            processed = processed + 1

            frmProgress.lblEmailCount.Caption = _
                processed & " / " & filteredItems.Count & " Emails Processed"

            frmProgress.lblDownloadedCount.Caption = _
                "PDFs Downloaded: " & downloaded

            frmProgress.lblBar.Width = _
                (processed / filteredItems.Count) * frmProgress.fraProgress.Width

            DoEvents

            tempMsgPath = savePath & _
                "TEMP_" & Format(Now, "yyyymmdd_hhnnss") & "_" & processed & ".msg"

            pdfSaved = False

            ' Save email
            On Error Resume Next
            mi.SaveAs tempMsgPath, 3

            If Err.Number <> 0 Then
                errWs.Cells(errRow, 1).Value = Now
                errWs.Cells(errRow, 2).Value = mi.Subject
                errWs.Cells(errRow, 3).Value = mi.ReceivedTime
                errWs.Cells(errRow, 4).Value = "MSG Save Failed"
                errRow = errRow + 1
                Err.Clear
                GoTo NextMail
            End If
            On Error GoTo MainError

            ' Open saved msg
            Set tempMail = Nothing

            On Error Resume Next
            Set tempMail = olApp.Session.OpenSharedItem(tempMsgPath)

            If Err.Number <> 0 Then
                errWs.Cells(errRow, 1).Value = Now
                errWs.Cells(errRow, 2).Value = mi.Subject
                errWs.Cells(errRow, 3).Value = mi.ReceivedTime
                errWs.Cells(errRow, 4).Value = "MSG Open Failed"
                errRow = errRow + 1
                Err.Clear
                GoTo NextMail
            End If
            On Error GoTo MainError

            ' Extract PDFs
            For Each at In tempMail.Attachments

                If LCase(Right(at.FileName, 4)) = ".pdf" Then

                    pdfPath = savePath & at.FileName

                    If Dir(pdfPath) <> "" Then
                        pdfPath = savePath & _
                        Format(Now, "yyyymmdd_hhnnss_") & at.FileName
                    End If

                    On Error Resume Next
                    at.SaveAsFile pdfPath

                    If Err.Number = 0 Then
                        downloaded = downloaded + 1
                        pdfSaved = True
                    Else
                        errWs.Cells(errRow, 1).Value = Now
                        errWs.Cells(errRow, 2).Value = mi.Subject
                        errWs.Cells(errRow, 3).Value = mi.ReceivedTime
                        errWs.Cells(errRow, 4).Value = _
                        "PDF Save Failed - " & at.FileName
                        errRow = errRow + 1
                        Err.Clear
                    End If

                    On Error GoTo MainError

                End If

            Next at

            ' Delete temp msg only if success
            If pdfSaved = True Then

                On Error Resume Next
                tempMail.Close 0
                Set tempMail = Nothing

                If Dir(tempMsgPath) <> "" Then
                    Kill tempMsgPath
                End If

                On Error GoTo MainError

            Else

                errWs.Cells(errRow, 1).Value = Now
                errWs.Cells(errRow, 2).Value = mi.Subject
                errWs.Cells(errRow, 3).Value = mi.ReceivedTime
                errWs.Cells(errRow, 4).Value = "No PDF extracted"
                errRow = errRow + 1

            End If

            ' Download log
            logWs.Cells(logRow, 1).Value = mi.Subject
            logWs.Cells(logRow, 2).Value = mi.ReceivedTime
            logWs.Cells(logRow, 3).Value = downloaded
            logRow = logRow + 1

        End If

NextMail:
    Next mi

    Unload frmProgress

    ws.Range("C15").Value = "Success"
    ws.Range("C16").Value = downloaded
    ws.Range("C17").Value = Now

    MsgBox downloaded & " PDF(s) downloaded successfully.", vbInformation

    Exit Sub

MainError:
    On Error Resume Next
    Unload frmProgress
    MsgBox "Error: " & Err.Description, vbCritical

End Sub


Function FindOutlookFolder(parentFolder As Object, targetName As String) As Object

    Dim subFolder As Object

    If LCase(Trim(parentFolder.Name)) = LCase(Trim(targetName)) Then
        Set FindOutlookFolder = parentFolder
        Exit Function
    End If

    For Each subFolder In parentFolder.Folders

        Set FindOutlookFolder = FindOutlookFolder(subFolder, targetName)

        If Not FindOutlookFolder Is Nothing Then
            Exit Function
        End If

    Next subFolder

End Function