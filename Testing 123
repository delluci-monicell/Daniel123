'=======================================================================
' HELPER: Convert hex colour string to Long for Interior.Color
'=======================================================================
Function HexToLong(h As String) As Long
    Dim r As Long, g As Long, b As Long
    r = CLng("&H" & Left(h, 2))
    g = CLng("&H" & Mid(h, 3, 2))
    b = CLng("&H" & Right(h, 2))
    HexToLong = RGB(r, g, b)
End Function

'=======================================================================
' HELPER: Style a banner / title cell
'=======================================================================
Sub StyleBanner(ws As Worksheet, r As Long, c1 As Long, c2 As Long, _
                txt As String, bgHex As String, Optional fgHex As String = "FFFFFF", _
                Optional sz As Integer = 14, Optional rh As Double = 35)
    ws.Cells(r, c1).Value = txt
    If c1 <> c2 Then ws.Range(ws.Cells(r, c1), ws.Cells(r, c2)).Merge
    With ws.Cells(r, c1)
        .Font.Name = "Arial"
        .Font.Bold = True
        .Font.Size = sz
        .Font.Color = HexToLong(fgHex)
        .Interior.Color = HexToLong(bgHex)
        .HorizontalAlignment = xlCenter
        .VerticalAlignment = xlCenter
        .WrapText = True
    End With
    ws.Rows(r).RowHeight = rh
End Sub

'=======================================================================
' HELPER: Style a standard header cell
'=======================================================================
Sub StyleHdr(c As Range, txt As String, bgHex As String, Optional sz As Integer = 10)
    c.Value = txt
    c.Font.Name = "Arial"
    c.Font.Bold = True
    c.Font.Size = sz
    c.Font.Color = HexToLong(hWhite)
    c.Interior.Color = HexToLong(bgHex)
    c.HorizontalAlignment = xlCenter
    c.VerticalAlignment = xlCenter
    c.WrapText = True
    c.Borders.LineStyle = xlContinuous
    c.Borders.Color = HexToLong("C0C8D0")
    c.Borders.Weight = xlThin
End Sub

'=======================================================================
' HELPER: Style a body cell
'=======================================================================
Sub StyleBody(c As Range, Optional bgHex As String = "FFFFFF", Optional bold As Boolean = False)
    c.Font.Name = "Arial"
    c.Font.Bold = bold
    c.Font.Size = 10
    c.Font.Color = HexToLong("2D3748")
    c.Interior.Color = HexToLong(bgHex)
    c.HorizontalAlignment = xlLeft
    c.VerticalAlignment = xlCenter
    c.Borders.LineStyle = xlContinuous
    c.Borders.Color = HexToLong("C0C8D0")
    c.Borders.Weight = xlThin
End Sub

'=======================================================================
' HELPER: Add a KPI card (2-row: big number + label below)
'=======================================================================
Sub AddKPI(ws As Worksheet, r As Long, c As Long, lbl As String, frm As String, _
           bgHex As String, Optional vsz As Integer = 28, Optional nfmt As String = "")
    ' Value row
    ws.Range(ws.Cells(r, c), ws.Cells(r, c + 1)).Merge
    With ws.Cells(r, c)
        .Formula = frm
        .Font.Name = "Arial"
        .Font.Bold = True
        .Font.Size = vsz
        .Font.Color = HexToLong(hWhite)
        .Interior.Color = HexToLong(bgHex)
        .HorizontalAlignment = xlCenter
        .VerticalAlignment = xlCenter
        If nfmt <> "" Then .NumberFormat = nfmt
    End With
    ' Label row
    ws.Range(ws.Cells(r + 1, c), ws.Cells(r + 1, c + 1)).Merge
    With ws.Cells(r + 1, c)
        .Value = lbl
        .Font.Name = "Arial"
        .Font.Bold = True
        .Font.Size = 9
        .Font.Color = HexToLong(hNavy)
        .Interior.Color = HexToLong(hLtBlue)
        .HorizontalAlignment = xlCenter
        .VerticalAlignment = xlCenter
    End With
End Sub

'=======================================================================
' MAIN ENTRY POINT — Run this macro
'=======================================================================
Sub BuildGermanyTVTracker()

    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.EnableEvents = False

    Dim wb As Workbook
    Set wb = ThisWorkbook

    ' ── Delete all existing sheets except one ──
    Dim ws As Worksheet
    For Each ws In wb.Sheets
        ws.Visible = xlSheetVisible
    Next ws
    Application.DisplayAlerts = False
    Do While wb.Sheets.Count > 1
        wb.Sheets(wb.Sheets.Count).Delete
    Loop
    Application.DisplayAlerts = True
    wb.Sheets(1).Name = "TEMP"

    ' ── Create all sheets ──
    Dim shNames(9) As String
    shNames(0) = "Home"
    shNames(1) = "TV Request Tracker"
    shNames(2) = "Dashboard"
    shNames(3) = "KPI Dashboard"
    shNames(4) = "Processor Dashboard"
    shNames(5) = "Validator Dashboard"
    shNames(6) = "Branch Dashboard"
    shNames(7) = "Monthly Report"
    shNames(8) = "Master Data"
    shNames(9) = "Instructions"

    Dim i As Integer
    For i = 0 To 9
        Dim newWs As Worksheet
        Set newWs = wb.Sheets.Add(After:=wb.Sheets(wb.Sheets.Count))
        newWs.Name = shNames(i)
    Next i
    Application.DisplayAlerts = False
    wb.Sheets("TEMP").Delete
    Application.DisplayAlerts = True

    ' ── Sheet tab colours ──
    wb.Sheets("Home").Tab.Color                = HexToLong(hGold)
    wb.Sheets("TV Request Tracker").Tab.Color  = HexToLong(hMidBlue)
    wb.Sheets("Dashboard").Tab.Color           = HexToLong(hGreen)
    wb.Sheets("KPI Dashboard").Tab.Color       = HexToLong(hAmber)
    wb.Sheets("Processor Dashboard").Tab.Color = HexToLong(hTeal)
    wb.Sheets("Validator Dashboard").Tab.Color = HexToLong(hGold)
    wb.Sheets("Branch Dashboard").Tab.Color    = HexToLong(hPurple)
    wb.Sheets("Monthly Report").Tab.Color      = HexToLong(hMidBlue)
    wb.Sheets("Master Data").Tab.Color         = HexToLong(hDarkGrey)
    wb.Sheets("Instructions").Tab.Color        = HexToLong(hNavy)

    ' ── Hide gridlines on all sheets ──
    For Each ws In wb.Sheets
        ws.Activate
        ActiveWindow.DisplayGridlines = False
    Next ws

    ' ── Build each sheet ──
    Call BuildMasterData(wb)
    Call BuildTracker(wb)
    Call BuildDashboard(wb)
    Call BuildKPIDashboard(wb)
    Call BuildProcessorDashboard(wb)
    Call BuildValidatorDashboard(wb)
    Call BuildBranchDashboard(wb)
    Call BuildMonthlyReport(wb)
    Call BuildHome(wb)
    Call BuildInstructions(wb)

    ' ── Activate Home ──
    wb.Sheets("Home").Activate
    wb.Sheets("Home").Range("A1").Select

    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    Application.EnableEvents = True

    MsgBox "Germany Tax Voucher Tracker built successfully!" & Chr(10) & Chr(10) & _
           "Sheets created: 10" & Chr(10) & _
           "Tracker rows ready: 10,000" & Chr(10) & _
           "Workflow engine: Active" & Chr(10) & _
           "Dashboards: Live" & Chr(10) & Chr(10) & _
           "Navigate using the Home sheet.", vbInformation, "Build Complete"

End Sub

