Option Explicit
Public Sub UpdateProgress(currentEmail As Long, totalEmails As Long, downloaded As Long)
    Dim progressPercent As Double
    Dim targetWidth As Double
    
    If totalEmails = 0 Then Exit Sub
    
    progressPercent = currentEmail / totalEmails
    
    If progressPercent > 1 Then
        progressPercent = 1
    End If
    
    lblStatus.Caption = "Downloading PDFs..."
    
    lblEmailCount.Caption = currentEmail & " / " & totalEmails & " Emails Processed"
    
    lblDownloadCount.Caption = "PDFs Downloaded: " & downloaded
    
    targetWidth = fraProgress.InsideWidth * progressPercent
    
    lblBar.Width = targetWidth
    
    DoEvents
End Sub

