Option Explicit

Sub DownloadPDFAttachments()

    On Error GoTo MainError

    Dim ws As Worksheet
    Dim logWs As Worksheet
    Dim errWs As Worksheet

    Set ws = ThisWorkbook.Sheets("PDF Downloader")
    Set logWs = ThisWorkbook.Sheets("Download Log")
    Set errWs = ThisWorkbook.Sheets("Error Log")

    Dim sEmail As String
    Dim sPath As String
    Dim sFolder As String

    Dim dFrom As Date
    Dim dTo As Date
    Dim tFrom As Date
    Dim tTo As Date

    Dim finalFrom As Date
    Dim finalTo As Date

    sEmail = Trim(ws.Range("C4").Value)
    dFrom = ws.Range("C5").Value
    tFrom = ws.Range("C6").Value
    dTo = ws.Range("C7").Value
    tTo = ws.Range("C8").Value
    sPath = Trim(ws.Range("C9").Value)
    sFolder = Trim(ws.Range("C10").Value)

    If Right(sPath, 1) <> "\" Then
        sPath = sPath & "\"
    End If

    If sEmail = "" Then
        MsgBox "Enter sender email address", vbExclamation
        Exit Sub
    End If

    If Dir(sPath, vbDirectory) = "" Then
        MsgBox "Folder path not found", vbExclamation
        Exit Sub
    End If

    finalFrom = Int(dFrom) + TimeValue(tFrom)
    finalTo = Int(dTo) + TimeValue(tTo)

    If finalFrom > finalTo Then
        MsgBox "Date/Time From cannot be greater than Date/Time To", vbExclamation
        Exit Sub
    End If

    '-------------------------
    ' Open Outlook
    '-------------------------
    Dim olApp As Object
    Dim olNs As Object
    Dim olFolder As Object

    On Error Resume Next
    Set olApp = GetObject(, "Outlook.Application")

    If olApp Is Nothing Then
        Set olApp = CreateObject("Outlook.Application")
    End If
    On Error GoTo MainError

    Set olNs = olApp.GetNamespace("MAPI")

    '-------------------------
    ' Find folder dynamically
    '-------------------------
    Set olFolder = FindOutlookFolder(olNs.GetDefaultFolder(6).Parent, sFolder)

    If olFolder Is Nothing Then
        MsgBox "Outlook folder not found: " & sFolder, vbCritical
        Exit Sub
    End If

    '-------------------------
    ' Filter emails
    '-------------------------
    Dim items As Object
    Dim filteredItems As Object
    Dim filter As String

    Set items = olFolder.Items
    items.Sort "[ReceivedTime]", True

    filter = "[ReceivedTime] >= '" & _
             Format(finalFrom, "ddddd h:nn AMPM") & _
             "' AND [ReceivedTime] <= '" & _
             Format(finalTo, "ddddd h:nn AMPM") & "'"

    Set filteredItems = items.Restrict(filter)

    If filteredItems.Count = 0 Then
        MsgBox "No emails found in selected range", vbInformation
        Exit Sub
    End If

    '-------------------------
    ' Progress Form
    '-------------------------
    frmProgress.lblStatus.Caption = "Preparing Emails..."
    frmProgress.lblCount.Caption = "0 / " & filteredItems.Count & " Emails Processed"
    frmProgress.lblDownloadedCount.Caption = "PDFs Downloaded: 0"
    frmProgress.lblBar.Width = 0

    frmProgress.Show vbModeless
    DoEvents

    '-------------------------
    ' Variables
    '-------------------------
    Dim mi As Object
    Dim at As Object
    Dim tempMail As Object

    Dim processed As Long
    Dim downloaded As Long
    Dim failed As Long

    Dim logRow As Long
    Dim errRow As Long

    Dim tempMsgPath As String
    Dim pdfPath As String
    Dim pdfSaved As Boolean

    logRow = logWs.Cells(logWs.Rows.Count, 1).End(xlUp).Row + 1
    errRow = errWs.Cells(errWs.Rows.Count, 1).End(xlUp).Row + 1

    '-------------------------
    ' Process Emails
    '-------------------------
    For Each mi In filteredItems

        If TypeName(mi) = "MailItem" Then

            processed = processed + 1

            frmProgress.lblCount.Caption = _
            processed & " / " & filteredItems.Count & " Emails Processed"

            frmProgress.lblDownloadedCount.Caption = _
            "PDFs Downloaded: " & downloaded

            frmProgress.lblBar.Width = _
            (processed / filteredItems.Count) * frmProgress.fraProgress.Width

            DoEvents

            tempMsgPath = sPath & _
            "TEMP_" & Format(Now, "yyyymmdd_hhnnss") & _
            "_" & processed & ".msg"

            On Error Resume Next
            mi.SaveAs tempMsgPath, 3

            If Err.Number <> 0 Then

                failed = failed + 1

                errWs.Cells(errRow, 1).Value = errRow - 1
                errWs.Cells(errRow, 2).Value = Now
                errWs.Cells(errRow, 3).Value = mi.ReceivedTime
                errWs.Cells(errRow, 4).Value = mi.Subject
                errWs.Cells(errRow, 5).Value = "MSG Save Failed"
                errWs.Cells(errRow, 6).Value = "N/A"
                errWs.Cells(errRow, 7).Value = Err.Description

                errRow = errRow + 1

                Err.Clear
                On Error GoTo 0
                GoTo NextEmail
            End If

            On Error GoTo 0

            pdfSaved = False

            Set tempMail = olApp.Session.OpenSharedItem(tempMsgPath)

            If Not tempMail Is Nothing Then

                For Each at In tempMail.Attachments

                    If LCase(Right(at.FileName, 4)) = ".pdf" Then

                        pdfPath = sPath & at.FileName

                        If Dir(pdfPath) <> "" Then
                            pdfPath = sPath & _
                            Format(Now, "yyyymmdd_hhnnss_") & at.FileName
                        End If

                        On Error Resume Next
                        at.SaveAsFile pdfPath

                        If Err.Number = 0 Then

                            downloaded = downloaded + 1
                            pdfSaved = True

                            logWs.Cells(logRow, 1).Value = logRow - 1
                            logWs.Cells(logRow, 2).Value = Now
                            logWs.Cells(logRow, 3).Value = mi.Subject
                            logWs.Cells(logRow, 4).Value = mi.ReceivedTime
                            logWs.Cells(logRow, 5).Value = at.FileName
                            logWs.Cells(logRow, 6).Value = pdfPath
                            logWs.Cells(logRow, 7).Value = "Success"

                            logRow = logRow + 1

                        Else

                            failed = failed + 1

                            errWs.Cells(errRow, 1).Value = errRow - 1
                            errWs.Cells(errRow, 2).Value = Now
                            errWs.Cells(errRow, 3).Value = mi.ReceivedTime
                            errWs.Cells(errRow, 4).Value = mi.Subject
                            errWs.Cells(errRow, 5).Value = at.FileName
                            errWs.Cells(errRow, 6).Value = "PDF Save Failed"
                            errWs.Cells(errRow, 7).Value = Err.Description

                            errRow = errRow + 1
                        End If

                        Err.Clear
                        On Error GoTo 0

                    End If

                Next at

                tempMail.Close 0
                Set tempMail = Nothing

            End If

            On Error Resume Next
            Kill tempMsgPath
            On Error GoTo 0

        End If

NextEmail:
    Next mi

    Unload frmProgress

    '-------------------------
    ' Status Update
    '-------------------------
    ws.Range("C15").Value = "Success"
    ws.Range("C16").Value = downloaded
    ws.Range("C17").Value = Now

    MsgBox "Process Completed!" & vbCrLf & _
           "PDFs Downloaded: " & downloaded & vbCrLf & _
           "Failed Emails: " & failed, vbInformation

    Exit Sub

MainError:
    On Error Resume Next
    Unload frmProgress
    MsgBox "Error: " & Err.Description, vbCritical

End Sub