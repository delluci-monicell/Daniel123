    c = c & "        Call HighlightVisibleColD(ws, lastRow, RGB(217, 225, 148))" & vbNewLine
    c = c & "        ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_LEGALSTATUS" & vbNewLine
    c = c & "    End If" & vbNewLine
    c = c & "    ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_FISCALCOUNTRY" & vbNewLine
    c = c & "    ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_PRESCRIPTION" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' STEP 6: AA = 2028 + Germany + Individual" & vbNewLine
    c = c & "    ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_PRESCRIPTION, _" & vbNewLine
    c = c & "        Criteria1:"">="" & YEAR_3 & ""/1/1"", Operator:=xlAnd, _" & vbNewLine
    c = c & "        Criteria2:=""<="" & YEAR_3 & ""/12/31""" & vbNewLine
    c = c & "    ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_FISCALCOUNTRY, _" & vbNewLine
    c = c & "        Criteria1:=""*"" & COUNTRY_2028 & ""*""" & vbNewLine
    c = c & "    If CheckIfValueExists(ws, lastRow, COL_LEGALSTATUS, LEGAL_STATUS_FILTER) Then" & vbNewLine
    c = c & "        ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_LEGALSTATUS, _" & vbNewLine
    c = c & "            Criteria1:=LEGAL_STATUS_FILTER" & vbNewLine
    c = c & "        Call HighlightVisibleColD(ws, lastRow, RGB(217, 225, 148))" & vbNewLine
    c = c & "        ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_LEGALSTATUS" & vbNewLine
    c = c & "    End If" & vbNewLine
    c = c & "    ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_FISCALCOUNTRY" & vbNewLine
    c = c & "    ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_PRESCRIPTION" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' Clear ALL filters" & vbNewLine
    c = c & "    If ws.AutoFilterMode Then ws.AutoFilterMode = False" & vbNewLine
    c = c & "    MsgBox ""Highlighting complete!"", vbInformation" & vbNewLine
    c = c & "End Sub" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "Sub HighlightVisibleColD(ws As Worksheet, lastRow As Long, clr As Long)" & vbNewLine
    c = c & "    Dim cell As Range" & vbNewLine
    c = c & "    On Error Resume Next" & vbNewLine
    c = c & "    For Each cell In ws.Range(""D"" & DATA_START_ROW & "":D"" & lastRow).SpecialCells(xlCellTypeVisible)" & vbNewLine
    c = c & "        cell.Interior.Color = clr" & vbNewLine
    c = c & "    Next cell" & vbNewLine
    c = c & "    On Error GoTo 0" & vbNewLine
    c = c & "End Sub" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "Function CheckIfValueExists(ws As Worksheet, lastRow As Long, colNum As Integer, searchVal As String) As Boolean" & vbNewLine
    c = c & "    Dim cell As Range" & vbNewLine
    c = c & "    CheckIfValueExists = False" & vbNewLine
    c = c & "    On Error Resume Next" & vbNewLine
    c = c & "    For Each cell In ws.Range(ws.Cells(DATA_START_ROW, colNum), ws.Cells(lastRow, colNum)).SpecialCells(xlCellTypeVisible)" & vbNewLine
    c = c & "        If InStr(1, CStr(cell.Value), searchVal, vbTextCompare) > 0 Then" & vbNewLine
    c = c & "            CheckIfValueExists = True" & vbNewLine
    c = c & "            Exit Function" & vbNewLine
    c = c & "        End If" & vbNewLine
    c = c & "    Next cell" & vbNewLine
    c = c & "    On Error GoTo 0" & vbNewLine
    c = c & "End Function" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "Sub ConvertTextToDate(ws As Worksheet, lastRow As Long)" & vbNewLine
    c = c & "    Dim rng As Range" & vbNewLine
    c = c & "    Set rng = ws.Range(ws.Cells(DATA_START_ROW, COL_PRESCRIPTION), ws.Cells(lastRow, COL_PRESCRIPTION))" & vbNewLine
    c = c & "    rng.TextToColumns Destination:=rng.Cells(1, 1), DataType:=xlDelimited, _" & vbNewLine
    c = c & "        TextQualifier:=xlDoubleQuote, ConsecutiveDelimiter:=False, _" & vbNewLine
    c = c & "        Tab:=False, Semicolon:=False, Comma:=False, Space:=False, Other:=False, _" & vbNewLine
    c = c & "        FieldInfo:=Array(1, xlDMYFormat), TrailingMinusNumbers:=True" & vbNewLine
    c = c & "End Sub" & vbNewLine

    mdl.CodeModule.AddFromString c
End Sub

