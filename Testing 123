        Array("MT 700", "A Letter of Credit — a bank guaranteeing payment once goods are shipped"), _
        Array("MT 760", "A Bank Guarantee or Standby LC — a safety net if someone fails their obligation"), _
        Array("MT 940", "A full bank account statement — all transactions for a period"), _
        Array("MT 942", "An intraday statement — transactions that happened today so far"), _
        Array("MT 300", "Foreign exchange deal confirmation between two banks"), _
        Array("MT 910", "A bank telling its customer their account has been credited (received funds)"), _
