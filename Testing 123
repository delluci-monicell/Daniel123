Sub INJECT_Module4_OldTracker(wb As Object)
    Dim mdl As Object
    Set mdl = wb.VBProject.VBComponents.Add(1)
    mdl.Name = "Mod4_OldTracker"

    Dim c As String
    c = "" & vbNewLine
    c = c & "Sub LookupFromOldTracker()" & vbNewLine
    c = c & "    Dim homeSht As Worksheet" & vbNewLine
    c = c & "    Dim oldPath As String" & vbNewLine
    c = c & "    Dim oldWB As Workbook" & vbNewLine
    c = c & "    Dim ws As Worksheet, sht As Worksheet" & vbNewLine
    c = c & "    Dim lastRow As Long" & vbNewLine
    c = c & "    Dim i As Long" & vbNewLine
    c = c & "    Dim lookupVal As String" & vbNewLine
    c = c & "    Dim foundCell As Range" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    Set homeSht = ThisWorkbook.Sheets(""Home"")" & vbNewLine
    c = c & "    oldPath = homeSht.Range(""OldTrackerPath"").Value" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    If oldPath = """" Then" & vbNewLine
    c = c & "        MsgBox ""Please browse and select the old tracker file first."", vbExclamation" & vbNewLine
    c = c & "        Exit Sub" & vbNewLine
    c = c & "    End If" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    Set oldWB = Workbooks.Open(oldPath)" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' Remove filters in all old tracker sheets" & vbNewLine
    c = c & "    For Each sht In oldWB.Sheets" & vbNewLine
    c = c & "        If sht.AutoFilterMode Then sht.AutoFilterMode = False" & vbNewLine
    c = c & "    Next sht" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    Dim l1Sht As Worksheet, l2Sht As Worksheet" & vbNewLine
    c = c & "    Set l1Sht = oldWB.Sheets(1)" & vbNewLine
    c = c & "    Set l2Sht = oldWB.Sheets(2)" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' Dynamic header detection" & vbNewLine
    c = c & "    Dim l1Hdr As Long, l2Hdr As Long" & vbNewLine
    c = c & "    l1Hdr = FindHeaderRow(l1Sht)" & vbNewLine
    c = c & "    l2Hdr = FindHeaderRow(l2Sht)" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    Set ws = ThisWorkbook.Sheets(""Working"")" & vbNewLine
    c = c & "    lastRow = ws.Cells(ws.Rows.Count, ""D"").End(xlUp).Row" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    For i = DATA_START_ROW To lastRow" & vbNewLine
    c = c & "        lookupVal = CStr(ws.Cells(i, COL_FORMREF).Value)" & vbNewLine
    c = c & "        If lookupVal = """" Then GoTo NextRow" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "        Set foundCell = SearchInSheet(l1Sht, l1Hdr, lookupVal)" & vbNewLine
    c = c & "        If foundCell Is Nothing Then" & vbNewLine
    c = c & "            Set foundCell = SearchInSheet(l2Sht, l2Hdr, lookupVal)" & vbNewLine
    c = c & "        End If" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "        If Not foundCell Is Nothing Then" & vbNewLine
    c = c & "            ws.Cells(i, COL_NAME).Value = foundCell.Offset(0, 1).Value" & vbNewLine
    c = c & "            ws.Cells(i, COL_ALLOCDATE).Value = foundCell.Offset(0, 2).Value" & vbNewLine
    c = c & "            ws.Cells(i, COL_COMMENTS).Value = foundCell.Offset(0, 3).Value" & vbNewLine
    c = c & "        End If" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "        NextRow:" & vbNewLine
    c = c & "    Next i" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' Paste E F G as values only" & vbNewLine
    c = c & "    ws.Range(ws.Cells(DATA_START_ROW, COL_NAME), ws.Cells(lastRow, COL_COMMENTS)).Copy" & vbNewLine
    c = c & "    ws.Cells(DATA_START_ROW, COL_NAME).PasteSpecial Paste:=xlPasteValues" & vbNewLine
    c = c & "    Application.CutCopyMode = False" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' Format F as short date, E and G as General" & vbNewLine
    c = c & "    ws.Range(ws.Cells(DATA_START_ROW, COL_ALLOCDATE), ws.Cells(lastRow, COL_ALLOCDATE)).NumberFormat = ""dd/mm/yyyy""" & vbNewLine
    c = c & "    ws.Range(ws.Cells(DATA_START_ROW, COL_NAME), ws.Cells(lastRow, COL_NAME)).NumberFormat = ""General""" & vbNewLine
    c = c & "    ws.Range(ws.Cells(DATA_START_ROW, COL_COMMENTS), ws.Cells(lastRow, COL_COMMENTS)).NumberFormat = ""General""" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    oldWB.Close SaveChanges:=False" & vbNewLine
    c = c & "    MsgBox ""Lookup from old tracker complete!"", vbInformation" & vbNewLine
    c = c & "End Sub" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "Function FindHeaderRow(sht As Worksheet) As Long" & vbNewLine
    c = c & "    Dim i As Long" & vbNewLine
    c = c & "    For i = 1 To 50" & vbNewLine
    c = c & "        If sht.Cells(i, 1).Value <> """" Then" & vbNewLine
    c = c & "            FindHeaderRow = i" & vbNewLine
    c = c & "            Exit Function" & vbNewLine
    c = c & "        End If" & vbNewLine
    c = c & "    Next i" & vbNewLine
    c = c & "    FindHeaderRow = 1" & vbNewLine
    c = c & "End Function" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "Function SearchInSheet(sht As Worksheet, hdrRow As Long, lookupVal As String) As Range" & vbNewLine
    c = c & "    Dim lastRow As Long" & vbNewLine
    c = c & "    Dim dataStart As Long" & vbNewLine
    c = c & "    lastRow = sht.Cells(sht.Rows.Count, ""D"").End(xlUp).Row" & vbNewLine
    c = c & "    dataStart = hdrRow + 1" & vbNewLine
    c = c & "    If dataStart > lastRow Then Set SearchInSheet = Nothing: Exit Function" & vbNewLine
    c = c & "    Set SearchInSheet = sht.Range(""D"" & dataStart & "":D"" & lastRow).Find(What:=lookupVal, LookIn:=xlValues, LookAt:=xlWhole)" & vbNewLine
    c = c & "End Function" & vbNewLine

    mdl.CodeModule.AddFromString c
End Sub

' ============================================================
' MODULE 5 — SHEET OPERATIONS
' ============================================================
Sub INJECT_Module5_SheetOps(wb As Object)
    Dim mdl As Object
    Set mdl = wb.VBProject.VBComponents.Add(1)
    mdl.Name = "Mod5_SheetOps"

    Dim c As String
    c = "" & vbNewLine
    c = c & "Sub SheetOperations()" & vbNewLine
    c = c & "    Dim ws As Worksheet" & vbNewLine
    c = c & "    Set ws = ThisWorkbook.Sheets(""Working"")" & vbNewLine
    c = c & "    Dim lastRow As Long" & vbNewLine
    c = c & "    lastRow = ws.Cells(ws.Rows.Count, ""D"").End(xlUp).Row" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    If ws.AutoFilterMode Then ws.AutoFilterMode = False" & vbNewLine
    c = c & "    ws.Rows(HEADER_ROW).AutoFilter" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' STEP 1: Filter Valid-Checked in Form Status col" & vbNewLine
    c = c & "    ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_FORMSTATUS, Criteria1:=VALID_CHECKED_STATUS" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' Create L2 sheet" & vbNewLine
    c = c & "    Dim l2WS As Worksheet" & vbNewLine
    c = c & "    Application.DisplayAlerts = False" & vbNewLine
    c = c & "    On Error Resume Next" & vbNewLine
    c = c & "    ThisWorkbook.Sheets(""L2 Allocation"").Delete" & vbNewLine
    c = c & "    On Error GoTo 0" & vbNewLine
    c = c & "    Application.DisplayAlerts = True" & vbNewLine
    c = c & "    Set l2WS = ThisWorkbook.Sheets.Add(After:=ws)" & vbNewLine
    c = c & "    l2WS.Name = ""L2 Allocation""" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' Copy visible range to L2 (includes legend + header + data)" & vbNewLine
    c = c & "    ws.UsedRange.SpecialCells(xlCellTypeVisible).Copy" & vbNewLine
    c = c & "    l2WS.Range(""A1"").PasteSpecial Paste:=xlPasteAll" & vbNewLine
    c = c & "    l2WS.Range(""A1"").PasteSpecial Paste:=xlPasteColumnWidths" & vbNewLine
    c = c & "    Application.CutCopyMode = False" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' Delete Valid-Checked rows from working sheet" & vbNewLine
    c = c & "    Call DeleteVisibleDataRows(ws, lastRow)" & vbNewLine
    c = c & "    If ws.AutoFilterMode Then ws.AutoFilterMode = False" & vbNewLine
    c = c & "    ws.Rows(HEADER_ROW).AutoFilter" & vbNewLine
    c = c & "    lastRow = ws.Cells(ws.Rows.Count, ""D"").End(xlUp).Row" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' STEP 2: Filter AU contains pending" & vbNewLine
    c = c & "    ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_SOL2, Criteria1:=""*"" & PENDING_KEYWORD & ""*""" & vbNewLine
    c = c & "    Call CopyVisibleToSheet(ws, l2WS, lastRow)" & vbNewLine
    c = c & "    Call DeleteVisibleDataRows(ws, lastRow)" & vbNewLine
    c = c & "    ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_SOL2" & vbNewLine
    c = c & "    lastRow = ws.Cells(ws.Rows.Count, ""D"").End(xlUp).Row" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' STEP 3: Filter AT contains pending" & vbNewLine
    c = c & "    ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_SOL, Criteria1:=""*"" & PENDING_KEYWORD & ""*""" & vbNewLine
    c = c & "    Call CopyVisibleToSheet(ws, l2WS, lastRow)" & vbNewLine
    c = c & "    Call DeleteVisibleDataRows(ws, lastRow)" & vbNewLine
    c = c & "    ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=COL_SOL" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' Clear all filters" & vbNewLine
    c = c & "    If ws.AutoFilterMode Then ws.AutoFilterMode = False" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' Rename working sheet to L1 Allocation" & vbNewLine
    c = c & "    ws.Name = ""L1 Allocation""" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' Format header row in both sheets" & vbNewLine
    c = c & "    Call FormatHeaderRow(ThisWorkbook.Sheets(""L1 Allocation""))" & vbNewLine
    c = c & "    Call FormatHeaderRow(l2WS)" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    MsgBox ""Sheet operations complete!"", vbInformation" & vbNewLine
    c = c & "End Sub" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "Sub DeleteVisibleDataRows(ws As Worksheet, lastRow As Long)" & vbNewLine
    c = c & "    Dim cell As Range, delRng As Range" & vbNewLine
    c = c & "    On Error Resume Next" & vbNewLine
    c = c & "    For Each cell In ws.Range(""A"" & DATA_START_ROW & "":A"" & lastRow).SpecialCells(xlCellTypeVisible)" & vbNewLine
    c = c & "        If delRng Is Nothing Then" & vbNewLine
    c = c & "            Set delRng = cell.EntireRow" & vbNewLine
    c = c & "        Else" & vbNewLine
    c = c & "            Set delRng = Union(delRng, cell.EntireRow)" & vbNewLine
    c = c & "        End If" & vbNewLine
    c = c & "    Next cell" & vbNewLine
    c = c & "    If Not delRng Is Nothing Then delRng.Delete" & vbNewLine
    c = c & "    On Error GoTo 0" & vbNewLine
    c = c & "End Sub" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "Sub CopyVisibleToSheet(ws As Worksheet, destWS As Worksheet, lastRow As Long)" & vbNewLine
    c = c & "    Dim visRng As Range" & vbNewLine
    c = c & "    Dim destRow As Long" & vbNewLine
    c = c & "    On Error Resume Next" & vbNewLine
    c = c & "    Set visRng = ws.Range(""A"" & DATA_START_ROW & "":"" & _" & vbNewLine
    c = c & "        ws.Cells(lastRow, ws.UsedRange.Columns.Count).Address).SpecialCells(xlCellTypeVisible)" & vbNewLine
    c = c & "    On Error GoTo 0" & vbNewLine
    c = c & "    If visRng Is Nothing Then Exit Sub" & vbNewLine
    c = c & "    destRow = destWS.Cells(destWS.Rows.Count, ""A"").End(xlUp).Row + 1" & vbNewLine
    c = c & "    visRng.Copy" & vbNewLine
    c = c & "    destWS.Cells(destRow, 1).PasteSpecial Paste:=xlPasteAll" & vbNewLine
    c = c & "    destWS.Cells(destRow, 1).PasteSpecial Paste:=xlPasteColumnWidths" & vbNewLine
    c = c & "    Application.CutCopyMode = False" & vbNewLine
    c = c & "End Sub" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "Sub FormatHeaderRow(ws As Worksheet)" & vbNewLine
    c = c & "    ' A6 B6 - Olive Green Accent3 Lighter 40%" & vbNewLine
    c = c & "    ws.Cells(HEADER_ROW, 1).Interior.Color = RGB(146, 208, 80)" & vbNewLine
    c = c & "    ws.Cells(HEADER_ROW, 2).Interior.Color = RGB(146, 208, 80)" & vbNewLine
    c = c & "    ' E6 F6 G6 - Red Accent2 Lighter 60%" & vbNewLine
    c = c & "    ws.Cells(HEADER_ROW, 5).Interior.Color = RGB(255, 153, 153)" & vbNewLine
    c = c & "    ws.Cells(HEADER_ROW, 6).Interior.Color = RGB(255, 153, 153)" & vbNewLine
    c = c & "    ws.Cells(HEADER_ROW, 7).Interior.Color = RGB(255, 153, 153)" & vbNewLine
    c = c & "End Sub" & vbNewLine

    mdl.CodeModule.AddFromString c
End Sub

' ============================================================
' MODULE 6 — EXPORT
' ============================================================
Sub INJECT_Module6_Export(wb As Object)
    Dim mdl As Object
    Set mdl = wb.VBProject.VBComponents.Add(1)
    mdl.Name = "Mod6_Export"

    Dim c As String
    c = "" & vbNewLine
    c = c & "Sub ExportTracker()" & vbNewLine
    c = c & "    Dim homeSht As Worksheet" & vbNewLine
    c = c & "    Dim outputPath As String" & vbNewLine
    c = c & "    Dim exportWB As Workbook" & vbNewLine
    c = c & "    Dim exportName As String" & vbNewLine
    c = c & "    Dim sht As Worksheet" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    Set homeSht = ThisWorkbook.Sheets(""Home"")" & vbNewLine
    c = c & "    outputPath = homeSht.Range(""OutputPath"").Value" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    If outputPath = """" Then" & vbNewLine
    c = c & "        MsgBox ""Please enter an output save path on the Home page."", vbExclamation" & vbNewLine
    c = c & "        Exit Sub" & vbNewLine
    c = c & "    End If" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    exportName = ""Workfile Tracker "" & Format(Now(), ""DD.MM.YYYY"") & "".xlsx""" & vbNewLine
    c = c & "    If Right(outputPath, 1) <> ""\"" Then outputPath = outputPath & ""\""" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    Set exportWB = Workbooks.Add" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ThisWorkbook.Sheets(""L1 Allocation"").Copy Before:=exportWB.Sheets(1)" & vbNewLine
    c = c & "    ThisWorkbook.Sheets(""L2 Allocation"").Copy After:=exportWB.Sheets(exportWB.Sheets.Count)" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    Application.DisplayAlerts = False" & vbNewLine
    c = c & "    For Each sht In exportWB.Sheets" & vbNewLine
    c = c & "        If sht.Name <> ""L1 Allocation"" And sht.Name <> ""L2 Allocation"" Then" & vbNewLine
    c = c & "            sht.Delete" & vbNewLine
    c = c & "        End If" & vbNewLine
    c = c & "    Next sht" & vbNewLine
    c = c & "    Application.DisplayAlerts = True" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    exportWB.SaveAs outputPath & exportName, xlOpenXMLWorkbook" & vbNewLine
    c = c & "    exportWB.Close" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    MsgBox ""Export complete!"" & vbNewLine & ""Saved to: "" & outputPath & exportName, vbInformation" & vbNewLine
    c = c & "End Sub" & vbNewLine

    mdl.CodeModule.AddFromString c
End Sub

