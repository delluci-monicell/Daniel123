    '=== VALIDATE REQUIRED FIELDS ===
    Dim missingFields As String
    missingFields = ""

    If ws.Range("C4").Value = "" Then missingFields = missingFields & "C4  - Sender Email Address" & vbNewLine
    If ws.Range("C5").Value = "" Then missingFields = missingFields & "C5  - Date From" & vbNewLine
    If ws.Range("C7").Value = "" Then missingFields = missingFields & "C7  - Date To" & vbNewLine
    If ws.Range("C9").Value = "" Then missingFields = missingFields & "C9  - Save Folder Path" & vbNewLine
    If ws.Range("C10").Value = "" Then missingFields = missingFields & "C10 - Outlook Folder Name" & vbNewLine

    If missingFields <> "" Then
        Call LockAllSheets(sheetPassword)
        MsgBox "Please fill in the following fields before running:" & _
               vbNewLine & vbNewLine & missingFields, _
               vbCritical, "Missing Required Fields"
        Exit Sub
    End If
