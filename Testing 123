    ' ---- Make the snapshot a normal, light-styled table instead of a raw color copy ----
    Dim snapLastCol As Long, snapLastRow As Long
    snapLastCol = tblBilling.ListColumns.Count
    snapLastRow = wsSnap.Cells(wsSnap.Rows.Count, 1).End(xlUp).Row
    If snapLastRow < 1 Then snapLastRow = 1

    Dim snapRange As Range
    Set snapRange = wsSnap.Range(wsSnap.Cells(1, 1), wsSnap.Cells(snapLastRow, snapLastCol))
    snapRange.Interior.ColorIndex = xlNone   ' clear the heavy fill inherited from the copy

    Dim tblSnap As ListObject
    On Error Resume Next
    Set tblSnap = wsSnap.ListObjects(1)
    On Error GoTo 0
    If tblSnap Is Nothing Then
        Set tblSnap = wsSnap.ListObjects.Add(xlSrcRange, snapRange, , xlYes)
    Else
        tblSnap.Resize snapRange
    End If
    tblSnap.TableStyle = "TableStyleLight9"
