Attribute VB_Name = "M_Billing"
' ============================================================
' Billing File Master - Automation Macros
'
' HOW TO INSTALL
'   1. Open "Billing File Master.xlsx" in desktop Excel, save it as
'      "Billing File Master.xlsm" (Macro-Enabled Workbook).
'   2. Alt+F11 to open the VBA editor -> File -> Import File -> pick
'      this .bas file. It creates a module called M_Billing.
'   3. Go back to Excel, on the Home sheet: Developer tab -> Insert ->
'      Form Controls -> Button. Draw one over the "GENERATE PREVIEW"
'      cell and assign macro GeneratePreview. Draw a second over
'      "VALIDATE & SAVE" and assign macro ValidateAndSave.
'   4. Fill in cell C5 (Tracker file path), C7 (Billing Year),
'      C8 (Billing Month) on the Home sheet.
'   5. Save. You're done -- click the buttons each month.
'
' IF YOUR REAL FILES USE DIFFERENT SHEET / TABLE / HEADER NAMES
'   Everything below reads columns by their HEADER TEXT, not by
'   column letter, so reordering columns is safe. Only the six
'   constants directly below need to match your actual file:
' ============================================================
Option Explicit

Private Const TRACKER_SHEET As String = "Voucher and CA Tracker"
Private Const TRACKER_TABLE As String = "TrackerTable"
Private Const BILLING_SHEET As String = "Billing Master"
Private Const BILLING_TABLE As String = "BillingMasterTable"
Private Const HOME_SHEET As String = "Home"

Private Const CELL_TRACKER_PATH As String = "C5"
Private Const CELL_YEAR As String = "C7"
Private Const CELL_MONTH As String = "C8"
Private Const PREVIEW_START_ROW As Long = 13   ' first data row of the preview block (header sits on row 12)
Private Const PREVIEW_START_COL As Long = 2    ' column B

' Remembers exactly which Tracker rows were included in the last preview,
' so Validate & Save bills precisely those rows (not a re-guessed set).
Private mSelectedTrackerRowNum() As Long
Private mSelectedKey() As String
Private mPreviewBuilt As Boolean

' ------------------------------------------------------------
Sub GeneratePreview()

    Dim wbTracker As Workbook
    Dim wsTracker As Worksheet
    Dim tblTracker As ListObject
    Dim wsHome As Worksheet
    Dim yearSel As Long, monthSel As Long
    Dim trackerPath As String
    Dim i As Long
    Dim colDateDispatch As Long, colHobartRef As Long, colAccountNum As Long
    Dim colAccountName As Long, colBillingItems As Long, colBillingStatus As Long
    Dim colTVStatus As Long
    Dim dictGroups As Object
    Dim key As String
    Dim dispatchDate As Variant
    Dim cnt As Long

    Set wsHome = ThisWorkbook.Sheets(HOME_SHEET)
    yearSel = Val(wsHome.Range(CELL_YEAR).Value)
    monthSel = MonthNumberFromName(CStr(wsHome.Range(CELL_MONTH).Value))
    trackerPath = Trim(wsHome.Range(CELL_TRACKER_PATH).Value)

    If yearSel = 0 Or monthSel = 0 Then
        MsgBox "Please select a valid Billing Year and Billing Month on the Home sheet.", vbExclamation
        Exit Sub
    End If
    If trackerPath = "" Then
        MsgBox "Please enter the Tracker file path/link in cell " & CELL_TRACKER_PATH & " on the Home sheet.", vbExclamation
        Exit Sub
    End If

    On Error Resume Next
    Set wbTracker = Workbooks.Open(Filename:=trackerPath, ReadOnly:=True, UpdateLinks:=False)
    On Error GoTo 0
    If wbTracker Is Nothing Then
        MsgBox "Could not open the Tracker file at:" & vbCrLf & trackerPath & vbCrLf & _
               "Check the path/link in cell " & CELL_TRACKER_PATH & ".", vbCritical
        Exit Sub
    End If

    Set wsTracker = wbTracker.Sheets(TRACKER_SHEET)
    Set tblTracker = wsTracker.ListObjects(TRACKER_TABLE)

    colDateDispatch = GetColIndex(tblTracker, "Date Original Dispatched")
    colHobartRef = GetColIndex(tblTracker, "Hobart Ref")
    colAccountNum = GetColIndex(tblTracker, "LC Bridge Account Number (LC)")
    colAccountName = GetColIndex(tblTracker, "Security Account Name")
    colBillingItems = GetColIndex(tblTracker, "No of Billing Items")
    colBillingStatus = GetColIndex(tblTracker, "Billing Completion Status")
    colTVStatus = GetColIndex(tblTracker, "TV Status")

    If colDateDispatch = 0 Or colHobartRef = 0 Or colAccountNum = 0 Or colAccountName = 0 _
       Or colBillingItems = 0 Or colBillingStatus = 0 Or colTVStatus = 0 Then
        wbTracker.Close SaveChanges:=False
        Exit Sub   ' GetColIndex already showed the error
    End If

    Set dictGroups = CreateObject("Scripting.Dictionary")
    cnt = 0
    ReDim mSelectedTrackerRowNum(1 To 1)
    ReDim mSelectedKey(1 To 1)

    If Not tblTracker.DataBodyRange Is Nothing Then
        For i = 1 To tblTracker.DataBodyRange.Rows.Count
            dispatchDate = tblTracker.DataBodyRange.Cells(i, colDateDispatch).Value
            Dim statusVal As String, tvStatusVal As String
            statusVal = Trim(CStr(tblTracker.DataBodyRange.Cells(i, colBillingStatus).Value))
            tvStatusVal = Trim(CStr(tblTracker.DataBodyRange.Cells(i, colTVStatus).Value))

            ' Only rows actually dispatched to (or acknowledged by) the client are billable.
            ' Pending / Invalid / not-yet-allocated rows are skipped even if a dispatch date is present.
            If IsDate(dispatchDate) And statusVal = "" And IsEligibleTVStatus(tvStatusVal) Then
                If Year(dispatchDate) = yearSel And Month(dispatchDate) = monthSel Then
                    Dim accNum As String, accName As String, hRef As String, qty As Double
                    accNum = Trim(CStr(tblTracker.DataBodyRange.Cells(i, colAccountNum).Value))
                    accName = Trim(CStr(tblTracker.DataBodyRange.Cells(i, colAccountName).Value))
                    hRef = Trim(CStr(tblTracker.DataBodyRange.Cells(i, colHobartRef).Value))
                    qty = Val(tblTracker.DataBodyRange.Cells(i, colBillingItems).Value)

                    If accNum <> "" And hRef <> "" Then
                        key = hRef & "|" & accNum
                        If dictGroups.Exists(key) Then
                            Dim arrE As Variant
                            arrE = dictGroups(key)
                            arrE(4) = arrE(4) + qty
                            dictGroups(key) = arrE
                        Else
                            dictGroups.Add key, Array(accNum, accName, hRef, dispatchDate, qty)
                        End If

                        cnt = cnt + 1
                        ReDim Preserve mSelectedTrackerRowNum(1 To cnt)
                        ReDim Preserve mSelectedKey(1 To cnt)
                        mSelectedTrackerRowNum(cnt) = tblTracker.DataBodyRange.Cells(i, 1).Row
                        mSelectedKey(cnt) = key
                    End If
                End If
            End If
        Next i
    End If

    wbTracker.Close SaveChanges:=False

    ClearPreviewArea

    If dictGroups.Count = 0 Then
        wsHome.Cells(PREVIEW_START_ROW, PREVIEW_START_COL) = _
            "No unbilled rows found for " & MonthAbbrev(monthSel) & " " & yearSel & "."
        mPreviewBuilt = False
    Else
        Dim k As Variant, rw As Long
        rw = PREVIEW_START_ROW
        For Each k In dictGroups.Keys
            Dim g As Variant
            g = dictGroups(k)
            wsHome.Cells(rw, PREVIEW_START_COL + 0) = g(0)
            wsHome.Cells(rw, PREVIEW_START_COL + 1) = g(1)
            wsHome.Cells(rw, PREVIEW_START_COL + 2) = g(2)
            wsHome.Cells(rw, PREVIEW_START_COL + 3) = Format(g(3), "dd/mm/yyyy")
            wsHome.Cells(rw, PREVIEW_START_COL + 4) = g(4)
            rw = rw + 1
        Next k
        mPreviewBuilt = True
        MsgBox dictGroups.Count & " account line(s) ready, covering " & cnt & _
               " tracker request(s) dispatched in " & MonthAbbrev(monthSel) & " " & yearSel & "." & vbCrLf & _
               "Review the preview below, then click VALIDATE & SAVE to commit.", vbInformation
    End If

End Sub

' ------------------------------------------------------------
Sub ValidateAndSave()

    Dim wsHome As Worksheet
    Set wsHome = ThisWorkbook.Sheets(HOME_SHEET)

    If Not mPreviewBuilt Then
        MsgBox "Run GENERATE PREVIEW first, and confirm there are rows to bill.", vbExclamation
        Exit Sub
    End If

    Dim trackerPath As String
    trackerPath = Trim(wsHome.Range(CELL_TRACKER_PATH).Value)
    Dim yearSel As Long, monthSel As Long, monthTxt As String, snapNameForPrompt As String
    yearSel = Val(wsHome.Range(CELL_YEAR).Value)
    monthSel = MonthNumberFromName(CStr(wsHome.Range(CELL_MONTH).Value))
    monthTxt = MonthAbbrev(monthSel)
    snapNameForPrompt = MonthFull(monthSel) & " " & yearSel

    If MsgBox("Add this data to the Billing Master sheet and create the '" & snapNameForPrompt & _
              "' sheet?" & vbCrLf & "(The matching Tracker rows will also be marked as billed.)", _
              vbYesNo + vbQuestion) = vbNo Then
        Exit Sub
    End If

    Dim wbTracker As Workbook
    Set wbTracker = Workbooks.Open(Filename:=trackerPath, ReadOnly:=False, UpdateLinks:=False)
    Dim wsTracker As Worksheet
    Set wsTracker = wbTracker.Sheets(TRACKER_SHEET)
    Dim tblTracker As ListObject
    Set tblTracker = wsTracker.ListObjects(TRACKER_TABLE)

    Dim colBillingItems As Long, colBillingStatus As Long
    colBillingItems = GetColIndex(tblTracker, "No of Billing Items")
    colBillingStatus = GetColIndex(tblTracker, "Billing Completion Status")

    Dim i As Long, rowNum As Long, itemsForRow As Double, statusText As String
    For i = LBound(mSelectedTrackerRowNum) To UBound(mSelectedTrackerRowNum)
        rowNum = mSelectedTrackerRowNum(i)
        itemsForRow = Val(wsTracker.Cells(rowNum, colBillingItems).Value)

        If itemsForRow >= 2 Then
            statusText = "Billed for TV and CA in the month of " & monthTxt
        Else
            statusText = "Billed for TV in the month of " & monthTxt
        End If
        wsTracker.Cells(rowNum, colBillingStatus).Value = statusText
    Next i

    wbTracker.Close SaveChanges:=True

    ' ---- Append to Billing Master table ----
    Dim wsBilling As Worksheet, tblBilling As ListObject
    Set wsBilling = ThisWorkbook.Sheets(BILLING_SHEET)
    Set tblBilling = wsBilling.ListObjects(BILLING_TABLE)

    Dim newRowsStart As Long
    newRowsStart = IIf(tblBilling.DataBodyRange Is Nothing, 0, tblBilling.DataBodyRange.Rows.Count) + 1

    Dim rw As Long
    rw = PREVIEW_START_ROW
    Do While Trim(wsHome.Cells(rw, PREVIEW_START_COL).Value) <> ""
        Dim newRow As ListRow
        Set newRow = tblBilling.ListRows.Add
        Dim r As Range
        Set r = newRow.Range

        r.Cells(1, GetColIndex(tblBilling, "Account Num")) = wsHome.Cells(rw, PREVIEW_START_COL + 0).Value
        r.Cells(1, GetColIndex(tblBilling, "Account Name")) = wsHome.Cells(rw, PREVIEW_START_COL + 1).Value
        r.Cells(1, GetColIndex(tblBilling, "Currency")) = "EUR"
        r.Cells(1, GetColIndex(tblBilling, "Dt Bill")) = wsHome.Cells(rw, PREVIEW_START_COL + 3).Value
        r.Cells(1, GetColIndex(tblBilling, "Dt Operation")) = wsHome.Cells(rw, PREVIEW_START_COL + 3).Value
        r.Cells(1, GetColIndex(tblBilling, "Internal Ref")) = wsHome.Cells(rw, PREVIEW_START_COL + 2).Value
        r.Cells(1, GetColIndex(tblBilling, "Amount Currency")) = "EUR"
        r.Cells(1, GetColIndex(tblBilling, "Quantity")) = wsHome.Cells(rw, PREVIEW_START_COL + 4).Value
        r.Cells(1, GetColIndex(tblBilling, "Operation Type")) = "Issuing of Tax Certificate"
        r.Cells(1, GetColIndex(tblBilling, "Subj. to Bill")) = "YES"

        rw = rw + 1
    Loop

    ' ---- Create (or reuse) a snapshot sheet for this month, e.g. "February 2026" ----
    Dim snapName As String
    snapName = MonthFull(monthSel) & " " & yearSel
    Dim wsSnap As Worksheet
    On Error Resume Next
    Set wsSnap = ThisWorkbook.Sheets(snapName)
    On Error GoTo 0
    If wsSnap Is Nothing Then
        Set wsSnap = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
        wsSnap.Name = snapName
        tblBilling.HeaderRowRange.Copy wsSnap.Range("A1")
    End If

    Dim lastSnapRow As Long
    lastSnapRow = wsSnap.Cells(wsSnap.Rows.Count, 1).End(xlUp).Row + 1
    If lastSnapRow < 2 Then lastSnapRow = 2

    Dim tblRowsNow As Long, addedCount As Long
    tblRowsNow = tblBilling.DataBodyRange.Rows.Count
    addedCount = tblRowsNow - newRowsStart + 1
    If addedCount > 0 Then
        tblBilling.DataBodyRange.Rows(newRowsStart).Resize(addedCount).Copy wsSnap.Cells(lastSnapRow, 1)
    End If

    ThisWorkbook.Save

    ClearPreviewArea
    mPreviewBuilt = False

    MsgBox "Done. Tracker updated & saved, Billing Master updated, snapshot sheet '" & snapName & "' ready.", vbInformation

End Sub

' ------------------------------------------------------------
' Helpers
' ------------------------------------------------------------
Private Function GetColIndex(tbl As ListObject, headerName As String) As Long
    Dim c As Long
    For c = 1 To tbl.ListColumns.Count
        If Trim(tbl.HeaderRowRange.Cells(1, c).Value) = headerName Then
            GetColIndex = c
            Exit Function
        End If
    Next c
    MsgBox "Column '" & headerName & "' not found in table '" & tbl.Name & "'. Check header spelling matches exactly.", vbCritical
    GetColIndex = 0
End Function

Private Function MonthNumberFromName(nm As String) As Long
    Dim i As Long
    For i = 1 To 12
        If StrComp(MonthName(i, True), nm, vbTextCompare) = 0 _
           Or StrComp(MonthName(i, False), nm, vbTextCompare) = 0 Then
            MonthNumberFromName = i
            Exit Function
        End If
    Next i
    MonthNumberFromName = 0
End Function

Private Function MonthAbbrev(m As Long) As String
    MonthAbbrev = MonthName(m, True)
End Function

Private Function MonthFull(m As Long) As String
    MonthFull = MonthName(m, False)
End Function

' A row is billable once it's actually been sent to the client -- TV Status of
' "Dispatched" or "Completed and acknowledgement received". Everything earlier
' (allocated / pending with AM / pending with chennai) or invalid is excluded,
' even if it happens to have a dispatch date filled in.
' Edit this list if your real Status-for-TV wording differs.
Private Function IsEligibleTVStatus(tvStatus As String) As Boolean
    Select Case tvStatus
        Case "Dispatched", "Completed and acknowledgement received"
            IsEligibleTVStatus = True
        Case Else
            IsEligibleTVStatus = False
    End Select
End Function

Private Sub ClearPreviewArea()
    Dim wsHome As Worksheet
    Set wsHome = ThisWorkbook.Sheets(HOME_SHEET)
    wsHome.Range(wsHome.Cells(PREVIEW_START_ROW, PREVIEW_START_COL), _
                  wsHome.Cells(PREVIEW_START_ROW + 200, PREVIEW_START_COL + 4)).ClearContents
End Sub
