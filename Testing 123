Option Explicit

'====================== YOUR REAL FILE — CONFIRMED VALUES ======================
Const DATA_SHEET       As String = "Master Data"
Const TEMPLATE_SHEET   As String = "BO Template intergreated"
Const SEQ_INPUT_CELL   As String = "M1"
Const SEQ_DATA_COL     As String = "B"
Const STATUS_COL       As Long = 26       ' column Z on Master Data

Const ACCOUNT_CELL     As String = "B18"
Const ISIN_CELL        As String = "F25"
Const QTY_CELL         As String = "F26"
Const PAYDATE_CELL     As String = "C26"

Const BLOCK_FIRST_ROW  As Long = 1        ' from your Print_Area: $B$1:$I$36
Const BLOCK_LAST_ROW   As Long = 36
'================================================================================

Sub RunBatchCreditAdviceExport()

    Dim modeChoice As VbMsgBoxResult
    modeChoice = MsgBox("Combine all Credit Advices into ONE PDF?" & vbCrLf & vbCrLf & _
                         "Yes = Combined (1 PDF containing every line)" & vbCrLf & _
                         "No = Individual (1 PDF per line)", _
                         vbYesNoCancel + vbQuestion, "Export Mode")

    Select Case modeChoice
        Case vbYes: DoCombinedExport
        Case vbNo:  DoSingleExport
        Case Else:  Exit Sub
    End Select

End Sub

'====================== INDIVIDUAL PDF PER LINE ======================
Private Sub DoSingleExport()

    Dim ZERO_CHECK_EXCLUDE() As Variant
    ZERO_CHECK_EXCLUDE = Array("B21")   ' Client Cash Account — confirm this address; add more if other fields are legitimately zero

    Dim wsData As Worksheet, wsTemplate As Worksheet
    Dim lastRow As Long, r As Long
    Dim seqNo As Variant
    Dim outputFolder As String, fileName As String, baseFileName As String
    Dim account As String, isin As String, qty As String, payDateSafe As String
    Dim issueList As String
    Dim startTime As Double
    Dim doneCount As Long, failCount As Long, skipCount As Long, warnCount As Long
    Dim folderPicker As FileDialog
    Dim regenerateAll As VbMsgBoxResult

    regenerateAll = MsgBox("Regenerate ALL rows, even ones already exported?" & vbCrLf & vbCrLf & _
                            "Yes = regenerate everything (overwrites existing PDFs, rewrites Status)" & vbCrLf & _
                            "No = only export what's missing (resume mode, skips existing)", _
                            vbYesNoCancel + vbQuestion, "Rerun Mode")
    If regenerateAll = vbCancel Then Exit Sub

    Set folderPicker = Application.FileDialog(msoFileDialogFolderPicker)
    folderPicker.Title = "Select folder to save Credit Advice PDFs"
    folderPicker.AllowMultiSelect = False
    If folderPicker.Show <> -1 Then
        MsgBox "No folder selected. Batch cancelled.", vbExclamation
        Exit Sub
    End If
    outputFolder = folderPicker.SelectedItems(1)
    If Right(outputFolder, 1) <> "\" Then outputFolder = outputFolder & "\"

    Set wsData = ThisWorkbook.Sheets(DATA_SHEET)
    Set wsTemplate = ThisWorkbook.Sheets(TEMPLATE_SHEET)
    lastRow = wsData.Cells(wsData.Rows.Count, SEQ_DATA_COL).End(xlUp).Row

    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.DisplayAlerts = False
    startTime = Timer

    For r = 2 To lastRow
        seqNo = wsData.Cells(r, SEQ_DATA_COL).Value
        If seqNo = "" Then GoTo NextRow

        wsTemplate.Range(SEQ_INPUT_CELL).Value = seqNo
        Application.CalculateFullRebuild   ' guarantees rows never bleed together

        account = CStr(wsTemplate.Range(ACCOUNT_CELL).Value)
        isin = CStr(wsTemplate.Range(ISIN_CELL).Value)
        qty = CStr(wsTemplate.Range(QTY_CELL).Value)
        payDateSafe = Replace(CStr(wsTemplate.Range(PAYDATE_CELL).Value), "/", "")

        baseFileName = CleanFileName(account & "_" & isin & "_" & qty & "_" & payDateSafe)
        fileName = baseFileName & ".pdf"

        ' The PDF on disk is the source of truth for "already done" — keeps
        ' resume working across a closed/reopened read-only file.
        If regenerateAll = vbNo And Dir(outputFolder & fileName) <> "" Then
            wsData.Cells(r, STATUS_COL).Value = "SKIPPED - PDF already exists"
            wsData.Cells(r, STATUS_COL).Interior.ColorIndex = xlColorIndexNone
            skipCount = skipCount + 1
            GoTo NextRow
        End If

        ' QA scan — read-only check of the template's formula results.
        ' Never modifies the template sheet in any way.
        issueList = CheckFormulaIssues(wsTemplate, BLOCK_FIRST_ROW, BLOCK_LAST_ROW, ZERO_CHECK_EXCLUDE)

        wsTemplate.ExportAsFixedFormat _
            Type:=xlTypePDF, Filename:=outputFolder & fileName, _
            Quality:=xlQualityStandard, IncludeDocProperties:=False, _
            IgnorePrintAreas:=False, OpenAfterPublish:=False

        If Dir(outputFolder & fileName) = "" Then
            wsData.Cells(r, STATUS_COL).Value = "FAILED - PDF not found after export at SeqNo " & seqNo
            wsData.Cells(r, STATUS_COL).Interior.Color = RGB(255, 150, 150)
            failCount = failCount + 1
        ElseIf issueList <> "" Then
            wsData.Cells(r, STATUS_COL).Value = "DONE - CHECK DATA: " & issueList & Format(Now, "dd/mm/yyyy hh:nn:ss")
            wsData.Cells(r, STATUS_COL).Interior.Color = RGB(255, 199, 132)
            warnCount = warnCount + 1
            doneCount = doneCount + 1
        Else
            wsData.Cells(r, STATUS_COL).Value = "DONE - " & Format(Now, "dd/mm/yyyy hh:nn:ss")
            wsData.Cells(r, STATUS_COL).Interior.ColorIndex = xlColorIndexNone
            doneCount = doneCount + 1
        End If

NextRow:
    Next r

CleanExit:
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    MsgBox "Finished in " & Format(Timer - startTime, "0.0") & " sec." & vbCrLf & _
           "Saved: " & doneCount & " (of which flagged for review: " & warnCount & ")" & vbCrLf & _
           "Failed: " & failCount & "   Skipped: " & skipCount & vbCrLf & _
           "Folder: " & outputFolder, vbInformation
End Sub

'====================== ONE COMBINED PDF FOR ALL LINES ======================
Private Sub DoCombinedExport()

    Dim wsData As Worksheet, wsTemplate As Worksheet, wsCombined As Worksheet
    Dim lastRow As Long, r As Long
    Dim seqNo As Variant
    Dim outputFolder As String, fileName As String, savePath As String, dupCounter As Long
    Dim blockHeight As Long, destFirstRow As Long
    Dim startTime As Double, includedCount As Long
    Dim folderPicker As FileDialog

    Set folderPicker = Application.FileDialog(msoFileDialogFolderPicker)
    folderPicker.Title = "Select folder to save the combined Credit Advice PDF"
    folderPicker.AllowMultiSelect = False
    If folderPicker.Show <> -1 Then
        MsgBox "No folder selected. Combined export cancelled.", vbExclamation
        Exit Sub
    End If
    outputFolder = folderPicker.SelectedItems(1)
    If Right(outputFolder, 1) <> "\" Then outputFolder = outputFolder & "\"

    fileName = "Combined_Germany_Advice_" & Format(Date, "yyyymmdd") & ".pdf"
    dupCounter = 1
    Do While Dir(outputFolder & fileName) <> ""   ' never silently overwrite a same-day run
        dupCounter = dupCounter + 1
        fileName = "Combined_Germany_Advice_" & Format(Date, "yyyymmdd") & "_v" & dupCounter & ".pdf"
    Loop
    savePath = outputFolder & fileName

    Set wsData = ThisWorkbook.Sheets(DATA_SHEET)
    Set wsTemplate = ThisWorkbook.Sheets(TEMPLATE_SHEET)
    lastRow = wsData.Cells(wsData.Rows.Count, SEQ_DATA_COL).End(xlUp).Row
    blockHeight = BLOCK_LAST_ROW - BLOCK_FIRST_ROW + 1

    Application.DisplayAlerts = False
    On Error Resume Next
    ThisWorkbook.Sheets("CombinedExport_TEMP").Delete
    On Error GoTo 0
    Set wsCombined = ThisWorkbook.Sheets.Add(After:=wsTemplate)
    wsCombined.Name = "CombinedExport_TEMP"
    Application.DisplayAlerts = True

    With wsCombined.PageSetup
        .Orientation = wsTemplate.PageSetup.Orientation
        .PaperSize = wsTemplate.PageSetup.PaperSize
        .TopMargin = wsTemplate.PageSetup.TopMargin
        .BottomMargin = wsTemplate.PageSetup.BottomMargin
        .LeftMargin = wsTemplate.PageSetup.LeftMargin
        .RightMargin = wsTemplate.PageSetup.RightMargin
        .FitToPagesWide = 1
        .FitToPagesTall = False
        .Zoom = False
    End With

    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    startTime = Timer
    destFirstRow = 1

    For r = 2 To lastRow
        seqNo = wsData.Cells(r, SEQ_DATA_COL).Value
        If seqNo = "" Then GoTo NextRow

        wsTemplate.Range(SEQ_INPUT_CELL).Value = seqNo
        Application.CalculateFullRebuild

        wsTemplate.Rows(BLOCK_FIRST_ROW & ":" & BLOCK_LAST_ROW).Copy
        wsCombined.Rows(destFirstRow).PasteSpecial xlPasteAll
        Application.CutCopyMode = False
        ' Row heights are NOT set explicitly — whatever the whole-row copy/paste
        ' carries over natively is left as-is. Nothing here touches wsTemplate.

        wsCombined.HPageBreaks.Add Before:=wsCombined.Rows(destFirstRow + blockHeight)

        includedCount = includedCount + 1
        destFirstRow = destFirstRow + blockHeight

NextRow:
    Next r

    If includedCount = 0 Then
        MsgBox "No rows were included - nothing to export.", vbExclamation
        GoTo CleanExit
    End If

    wsCombined.PageSetup.PrintArea = "A1:I" & (destFirstRow - 1)
    wsCombined.ExportAsFixedFormat _
        Type:=xlTypePDF, Filename:=savePath, Quality:=xlQualityStandard, _
        IncludeDocProperties:=False, IgnorePrintAreas:=False, OpenAfterPublish:=False

CleanExit:
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    Application.DisplayAlerts = False
    If Not wsCombined Is Nothing Then wsCombined.Delete
    Application.DisplayAlerts = True
    MsgBox "Combined export finished in " & Format(Timer - startTime, "0.0") & " sec." & vbCrLf & _
           "Advices included: " & includedCount & vbCrLf & "Saved as: " & savePath, vbInformation
End Sub

'====================== HELPERS ======================
Private Function CheckFormulaIssues(ws As Worksheet, firstRow As Long, lastRow As Long, excludeList As Variant) As String
    Dim c As Range, issues As String, addr As String, isExcluded As Boolean, ex As Variant

    For Each c In ws.Range(ws.Cells(firstRow, "B"), ws.Cells(lastRow, "I"))
        If c.HasFormula Then
            addr = c.Address(False, False)
            isExcluded = False
            For Each ex In excludeList
                If addr = ex Then isExcluded = True
            Next ex

            If IsError(c.Value) Then
                issues = issues & addr & "=" & CStr(c.Value) & "; "
            ElseIf Not isExcluded And IsNumeric(c.Value) And c.Value = 0 Then
                issues = issues & addr & "=ZERO; "
            End If
        End If
    Next c

    CheckFormulaIssues = issues
End Function

Private Function CleanFileName(s As String) As String
    Dim badChars As Variant, ch As Variant
    badChars = Array("\", "/", ":", "*", "?", Chr(34), "<", ">", "|")
    For Each ch In badChars
        s = Replace(s, ch, "-")
    Next ch
    CleanFileName = s
End Function
