Sub BuildTracker(wb As Workbook)
    Dim ws As Worksheet
    Set ws = wb.Sheets("TV Request Tracker")
    ws.Cells.Clear

    Dim colHdrs(25) As String
    colHdrs(0)  = "S.No"
    colHdrs(1)  = "Date Request" & Chr(10) & "Received"
    colHdrs(2)  = "Hobart SR" & Chr(10) & "Reference"
    colHdrs(3)  = "Stock" & Chr(10) & "Reference"
    colHdrs(4)  = "Security Account" & Chr(10) & "Number"
    colHdrs(5)  = "Security Account" & Chr(10) & "Name"
    colHdrs(6)  = "Branch"
    colHdrs(7)  = "Client Family"
    colHdrs(8)  = "Processor"
    colHdrs(9)  = "Validator"
    colHdrs(10) = "Date Original" & Chr(10) & "Dispatched"
    colHdrs(11) = "DHL Number"
    colHdrs(12) = "Stock" & Chr(10) & "Renounced"
    colHdrs(13) = "Billing File" & Chr(10) & "Completed"
    colHdrs(14) = "Reason For" & Chr(10) & "Pending"
    colHdrs(15) = "Status"
    colHdrs(16) = "Workflow" & Chr(10) & "Stage"
    colHdrs(17) = "Stage" & Chr(10) & "Number"
    colHdrs(18) = "SLA Due" & Chr(10) & "Date"
    colHdrs(19) = "Working Day" & Chr(10) & "Aging"
    colHdrs(20) = "Days" & Chr(10) & "Remaining"
    colHdrs(21) = "SLA Status"
    colHdrs(22) = "Priority"
    colHdrs(23) = "Completion" & Chr(10) & "Date"
    colHdrs(24) = "Resolution" & Chr(10) & "Time"
    colHdrs(25) = "Comments"

    Dim colWidths(25) As Double
    colWidths(0)=5: colWidths(1)=14: colWidths(2)=16: colWidths(3)=14
    colWidths(4)=16: colWidths(5)=22: colWidths(6)=14: colWidths(7)=14
    colWidths(8)=14: colWidths(9)=14: colWidths(10)=15: colWidths(11)=14
    colWidths(12)=13: colWidths(13)=15: colWidths(14)=24: colWidths(15)=24
    colWidths(16)=22: colWidths(17)=10: colWidths(18)=13: colWidths(19)=12
    colWidths(20)=12: colWidths(21)=13: colWidths(22)=12: colWidths(23)=14
    colWidths(24)=12: colWidths(25)=28

    StyleBanner ws, 1, 1, 26, "GERMANY TAX VOUCHER TRACKER - TV Request Register", hNavy, hWhite, 14, 38

    Dim ci As Integer
    For ci = 0 To 25
        StyleHdr ws.Cells(2, ci + 1), colHdrs(ci), hBlue, 9
        ws.Columns(ci + 1).ColumnWidth = colWidths(ci)
    Next ci
    ws.Rows(2).RowHeight = 40

    ws.Range("A3").Select
    ActiveWindow.FreezePanes = True

    ws.Range("A3:A10002").FormulaR1C1 = "=IF(RC[1]<>"""",ROW()-2,"""")"

    ws.Range("R3:R10002").FormulaR1C1 = _
        "=IF(RC[-16]="""","""",IFS(" & _
        "RC[-4]=""Yes"",9," & _
        "AND(RC[-4]=""No"",RC[-5]=""Yes""),8," & _
        "RC[-5]=""Yes"",7," & _
        "RC[-5]=""No"",6," & _
        "AND(RC[-7]<>"""",RC[-6]<>""""),5," & _
        "AND(RC[-3]<>"""",RC[-10]=""Local""),4," & _
        "AND(RC[-3]<>"""",RC[-10]=""Global""),3," & _
        "RC[-9]<>"""",2," & _
        "AND(RC[-16]<>"""",RC[-15]<>""""),1," & _
        "TRUE,0))"

    ws.Range("P3:P10002").FormulaR1C1 = _
        "=IF(RC[-14]="""","""",IFS(" & _
        "RC[2]=""Yes"",""Process Completed""," & _
        "AND(RC[2]=""No"",RC[1]=""Yes""),""Billing Yet to be Completed""," & _
        "RC[1]=""Yes"",""Stock Renounced""," & _
        "RC[1]=""No"",""Stock Yet to be Renounced""," & _
        "AND(RC[-5]<>"""",RC[-4]<>""""),""TV Dispatched to Claimant""," & _
        "AND(RC[3]<>"""",RC[-8]=""Local""),""Pending with Claimant""," & _
        "AND(RC[3]<>"""",RC[-8]=""Global""),""Pending with Account Managers""," & _
        "RC[-7]<>"""",""Under Processing""," & _
        "AND(RC[-14]<>"""",RC[-13]<>""""),""New Request Received""," & _
        "TRUE,""Incomplete Data""))"

    ws.Range("Q3:Q10002").FormulaR1C1 = _
        "=IF(RC[1]="""","""",IFS(" & _
        "RC[1]=9,""Stage 9 - Process Completed""," & _
        "RC[1]=8,""Stage 8 - Billing Yet to be Completed""," & _
        "RC[1]=7,""Stage 7 - Stock Renounced""," & _
        "RC[1]=6,""Stage 6 - Stock Yet to be Renounced""," & _
        "RC[1]=5,""Stage 5 - TV Dispatched to Claimant""," & _
        "RC[1]=4,""Stage 4 - Pending with Claimant""," & _
        "RC[1]=3,""Stage 3 - Pending with Account Managers""," & _
        "RC[1]=2,""Stage 2 - Under Processing""," & _
        "RC[1]=1,""Stage 1 - New Request Received""," & _
        "TRUE,""""))"

    ws.Range("S3:S10002").FormulaR1C1 = _
        "=IF(RC[-17]="""","""",WORKDAY(RC[-17],5))"
