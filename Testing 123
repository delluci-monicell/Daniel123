    c = c & "" & vbNewLine
    c = c & "    If ws.AutoFilterMode Then ws.AutoFilterMode = False" & vbNewLine
    c = c & "    ws.Rows(HEADER_ROW).AutoFilter" & vbNewLine
    c = c & "" & vbNewLine
    c = c & "    ' STEP 1: SLA 0-45 filter - highlight D Blue" & vbNewLine
    c = c & "    ws.Range(""A"" & HEADER_ROW).AutoFilter Field:=1, _" & vbNewLine
