    '=== FIND TARGET FOLDER ===
    Dim targetFolder As Object
    Dim rootFolder As Object
    Dim f As Object
    Dim subF As Object
    Dim found As Boolean
    found = False

    ' Loop through all mailboxes directly via Folders collection
    Dim mb As Object
    For Each mb In olNs.Folders
        ' Check direct children of each mailbox
        For Each f In mb.Folders
            If LCase(Trim(f.Name)) = LCase(Trim(outlookFolder)) Then
                Set targetFolder = f
                found = True
                Exit For
            End If
            ' Check one level deeper
            For Each subF In f.Folders
                If LCase(Trim(subF.Name)) = LCase(Trim(outlookFolder)) Then
                    Set targetFolder = subF
                    found = True
                    Exit For
                End If
            Next subF
            If found Then Exit For
        Next f
        If found Then Exit For
    Next mb

    If Not found Then
        ' List all folders for diagnosis
        Dim folderList As String
        folderList = ""
        For Each mb In olNs.Folders
            folderList = folderList & ">> " & mb.Name & vbNewLine
            For Each f In mb.Folders
                folderList = folderList & "  - " & f.Name & vbNewLine
            Next f
        Next mb
        MsgBox "Folder '" & outlookFolder & "' not found." & vbNewLine & vbNewLine & _
               "Folders found:" & vbNewLine & folderList, vbCritical
        Exit Sub
    End If
