Sub DownloadAttachments()

    '=== SHEETS ===
    Dim ws As Worksheet
    Dim logWs As Worksheet
    Dim errWs As Worksheet

    Set ws = ThisWorkbook.Sheets("PDF Downloader")
    Set logWs = ThisWorkbook.Sheets("Download Log")
    Set errWs = ThisWorkbook.Sheets("Error Log")

    '=== READ SETTINGS ===
    Dim senderEmail As String
    Dim sPath As String
    Dim outlookFolder As String
    Dim fromDateTime As Date
    Dim toDateTime As Date

    On Error GoTo ReadError
    senderEmail = Trim(ws.Range("C4").Value)
    sPath = Trim(ws.Range("C9").Value)
    outlookFolder = Trim(ws.Range("C10").Value)
    fromDateTime = CDate(ws.Range("C5").Value) + CDate(ws.Range("C6").Value)
    toDateTime = CDate(ws.Range("C7").Value) + CDate(ws.Range("C8").Value)
    On Error GoTo 0

    '=== VALIDATE FOLDER PATH ===
    If Right(sPath, 1) <> "\" Then sPath = sPath & "\"
    If Dir(sPath, vbDirectory) = "" Then
        MsgBox "Save folder not found: " & sPath, vbCritical
        Exit Sub
    End If

    '=== CONNECT TO OUTLOOK ===
    Dim olApp As Object
    Dim olNs As Object

    On Error GoTo OutlookError
    Set olApp = CreateObject("Outlook.Application")
    Set olNs = olApp.GetNamespace("MAPI")
    olNs.Logon
    On Error GoTo 0

    '=== FIND TARGET FOLDER ===
    Dim targetFolder As Object
    Dim rootFolder As Object
    Dim f As Object
    Dim found As Boolean
    found = False

    Dim i As Integer
    For i = 1 To olNs.Stores.Count
        On Error Resume Next
        Set rootFolder = olNs.Stores(i).GetRootFolder()
        If Err.Number <> 0 Then
            Err.Clear
            GoTo NextStore
        End If
        On Error GoTo 0

        For Each f In rootFolder.Folders
            If LCase(Trim(f.Name)) = LCase(Trim(outlookFolder)) Then
                Set targetFolder = f
                found = True
                Exit For
            End If
        Next f

        If found Then Exit For

NextStore:
    Next i

    If Not found Then
        MsgBox "Folder '" & outlookFolder & "' not found in Outlook.", vbCritical
        Exit Sub
    End If

    '=== BUILD FILTER ===
    Dim filter As String
    filter = "[ReceivedTime] >= '" & Format(fromDateTime, "mm/dd/yyyy hh:mm AMPM") & "'" & _
             " AND [ReceivedTime] <= '" & Format(toDateTime, "mm/dd/yyyy hh:mm AMPM") & "'"

    Dim filteredItems As Object
    Set filteredItems = targetFolder.Items.Restrict(filter)

    '=== LOG ROW COUNTERS ===
    Dim logRow As Long
    Dim errRow As Long
    logRow = logWs.Cells(logWs.Rows.Count, 1).End(xlUp).Row + 1
    errRow = errWs.Cells(errWs.Rows.Count, 1).End(xlUp).Row + 1

    '=== COUNTERS ===
    Dim downloaded As Long
    Dim processed As Long
    downloaded = 0
    processed = 0

    '=== LOOP EMAILS ===
    Dim mi As Object
    Dim tempMail As Object
    Dim at As Object
    Dim tempMsgPath As String
    Dim savePath As String
    Dim pdfSaved As Boolean
    Dim miEmail As String

    For Each mi In filteredItems

        If TypeName(mi) <> "MailItem" Then GoTo NextMail

        '=== GET SENDER EMAIL ===
        miEmail = ""
        On Error Resume Next
        miEmail = mi.SenderEmailAddress
        If InStr(miEmail, "@") = 0 Then
            miEmail = mi.Sender.GetExchangeUser.PrimarySmtpAddress
        End If
        On Error GoTo 0

        If LCase(Trim(miEmail)) <> LCase(senderEmail) Then GoTo NextMail

        processed = processed + 1

        '=== SAVE AS TEMP MSG ===
        tempMsgPath = sPath & "TEMP_" & Format(Now, "yyyymmdd_hhnnss") & "_" & processed & ".msg"

        On Error Resume Next
        mi.SaveAs tempMsgPath, 3
        If Err.Number <> 0 Then
            Call LogError(errWs, errRow, Now, mi.ReceivedTime, mi.Subject, "", tempMsgPath, "MSG Save Failed: " & Err.Description, "")
            errRow = errRow + 1
            Err.Clear
            GoTo NextMail
        End If
        On Error GoTo 0

        '=== OPEN TEMP MSG ===
        Set tempMail = Nothing
        On Error Resume Next
        Set tempMail = olApp.Session.OpenSharedItem(tempMsgPath)
        If Err.Number <> 0 Or tempMail Is Nothing Then
            Call LogError(errWs, errRow, Now, mi.ReceivedTime, mi.Subject, "", tempMsgPath, "MSG Open Failed: " & Err.Description, "")
            errRow = errRow + 1
            Err.Clear
            GoTo CleanTemp
        End If
        On Error GoTo 0

        pdfSaved = False

        '=== SAVE ATTACHMENTS ===
        For Each at In tempMail.Attachments

            savePath = sPath & at.FileName
            If Dir(savePath) <> "" Then
                savePath = sPath & Format(Now, "yyyymmdd_hhnnss_") & processed & "_" & at.FileName
            End If

            On Error Resume Next
            at.SaveAsFile savePath
            If Err.Number <> 0 Then
                Call LogError(errWs, errRow, Now, mi.ReceivedTime, mi.Subject, at.FileName, tempMsgPath, "Attachment Save Failed: " & Err.Description, savePath)
                errRow = errRow + 1
                Err.Clear
            Else
                downloaded = downloaded + 1
                pdfSaved = True
                logWs.Cells(logRow, 1).Value = logRow - 1
                logWs.Cells(logRow, 2).Value = Now
                logWs.Cells(logRow, 3).Value = mi.Subject
                logWs.Cells(logRow, 4).Value = miEmail
                logWs.Cells(logRow, 5).Value = at.FileName
                logWs.Cells(logRow, 6).Value = "Success"
                logWs.Cells(logRow, 7).Value = savePath
                logRow = logRow + 1
            End If
            On Error GoTo 0

        Next at

        '=== LOG IF NO ATTACHMENTS ===
        If pdfSaved = False Then
            Call LogError(errWs, errRow, Now, mi.ReceivedTime, mi.Subject, "", tempMsgPath, "No Attachments Found", "")
            errRow = errRow + 1
        End If

CleanTemp:
        '=== CLOSE AND DELETE TEMP MSG ===
        On Error Resume Next
        If Not tempMail Is Nothing Then
            tempMail.Close 0
            Set tempMail = Nothing
        End If
        DoEvents
        Application.Wait Now + TimeValue("00:00:02")
        If Dir(tempMsgPath) <> "" Then Kill tempMsgPath
        On Error GoTo 0

NextMail:
    Next mi

    '=== UPDATE STATUS ===
    ws.Range("C15").Value = "Success"
    ws.Range("C16").Value = downloaded
    ws.Range("C17").Value = Now

    MsgBox downloaded & " attachment(s) downloaded from " & processed & " matching email(s).", vbInformation
    Exit Sub

'=== ERROR HANDLERS ===
ReadError:
    MsgBox "Error reading settings from sheet. Please check cells C4 to C10." & vbNewLine & Err.Description, vbCritical
    Exit Sub

OutlookError:
    MsgBox "Could not connect to Outlook. Please make sure Outlook is open." & vbNewLine & Err.Description, vbCritical
    Exit Sub

End Sub

'=== HELPER: LOG ERROR ROW ===
Sub LogError(errWs As Worksheet, errRow As Long, macroTime As Date, _
             receivedTime As Variant, subject As String, attachName As String, _
             msgPath As String, reason As String, fullPath As String)

    errWs.Cells(errRow, 1).Value = errRow - 1
    errWs.Cells(errRow, 2).Value = macroTime
    errWs.Cells(errRow, 3).Value = receivedTime
    errWs.Cells(errRow, 4).Value = subject
    errWs.Cells(errRow, 5).Value = attachName
    errWs.Cells(errRow, 6).Value = msgPath
    errWs.Cells(errRow, 7).Value = reason
    errWs.Cells(errRow, 8).Value = fullPath

End Sub
